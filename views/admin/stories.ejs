<% layout("/layouts/boilerplate") -%>

<div class="admin-stories-page page-container" style="max-width: 1100px;">

    <div style="margin-bottom: 20px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <h1 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 0;">Admin: Success Stories</h1>
            <span style="background: #ef4444; color: white; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px; text-transform: uppercase;">ADMIN ONLY</span>
        </div>
        <p style="color: #64748b; font-size: 14px; margin: 6px 0 0 0;">
            Review and approve real student hackathon success stories before they appear on the campus dashboard.
        </p>
    </div>

    <!-- Admin Subnav Tabs -->
    <div style="display: flex; gap: 12px; margin-bottom: 24px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
        <a href="/admin/organizers" style="padding: 8px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; background: #f1f5f9; color: #475569;">
            Organizer Requests
        </a>
        <a href="/admin/stories" style="padding: 8px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; background: #2563eb; color: white;">
            Success Stories (<%= pendingStories ? pendingStories.length : 0 %>)
        </a>
    </div>

    <!-- Section 1: Pending Success Stories -->
    <div style="margin-bottom: 36px;">
        <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            Pending Stories 
            <span style="background: #fef3c7; color: #b45309; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">
                <%= pendingStories ? pendingStories.length : 0 %>
            </span>
        </h2>

        <% if (pendingStories && pendingStories.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 14px;">
                <% pendingStories.forEach(story => { %>
                    <div style="background: white; border: 1px solid #fed7aa; border-left: 4px solid #f97316; border-radius: 12px; padding: 20px 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.03);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 14px; margin-bottom: 12px;">
                            <div>
                                <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 4px 0;">
                                    <%= story.teamName %>
                                </h3>
                                <div style="font-size: 13px; color: #64748b;">
                                    Event: <strong style="color: #4338ca;"><%= story.eventName %></strong> · 
                                    Submitted by: <strong><%= story.createdBy ? story.createdBy.name : 'Unknown' %></strong> (<%= story.createdBy ? story.createdBy.email : '' %>) ·
                                    Submitted: <%= formatDate(story.createdAt) %>
                                </div>
                            </div>
                            <span style="background: #ffedd5; color: #c2410c; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">
                                PENDING APPROVAL
                            </span>
                        </div>

                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px 16px; font-size: 14px; color: #334155; margin-bottom: 16px; line-height: 1.5; font-style: italic;">
                            "<%= story.summary %>"
                        </div>

                        <% if (story.memberUserIds && story.memberUserIds.length > 0) { %>
                            <div style="font-size: 12.5px; color: #64748b; margin-bottom: 16px;">
                                <strong>Team Members (<%= story.memberUserIds.length %>):</strong>
                                <%= story.memberUserIds.map(m => m.name + (m.department ? ' (' + m.department + ')' : '')).join(', ') %>
                            </div>
                        <% } %>

                        <div style="display: flex; justify-content: flex-end; gap: 10px;">
                            <form action="/admin/stories/<%= story._id %>/reject" method="POST" style="margin: 0;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn-small-outline" style="border-color: #fca5a5; color: #dc2626; padding: 8px 16px; font-size: 13px; border-radius: 6px; cursor: pointer; background: white;">
                                    Reject / Delete
                                </button>
                            </form>
                            <form action="/admin/stories/<%= story._id %>/approve" method="POST" style="margin: 0;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn-small-primary" style="background: #16a34a; border-color: #16a34a; padding: 8px 18px; font-size: 13px; border-radius: 6px; cursor: pointer;">
                                    ✓ Approve & Publish to Dashboard
                                </button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div style="background: white; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 32px; text-align: center; color: #64748b; font-size: 14px;">
                No pending success stories awaiting approval.
            </div>
        <% } %>
    </div>

    <!-- Section 2: Approved Stories -->
    <div>
        <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            Published Stories 
            <span style="background: #dcfce7; color: #15803d; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">
                <%= approvedStories ? approvedStories.length : 0 %>
            </span>
        </h2>

        <% if (approvedStories && approvedStories.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 14px;">
                <% approvedStories.forEach(story => { %>
                    <div style="background: white; border: 1px solid #e2e8f0; border-left: 4px solid #16a34a; border-radius: 12px; padding: 20px 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.03);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 14px; margin-bottom: 10px;">
                            <div>
                                <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 4px 0;">
                                    <%= story.teamName %>
                                </h3>
                                <div style="font-size: 13px; color: #64748b;">
                                    Event: <strong style="color: #4338ca;"><%= story.eventName %></strong> · 
                                    Team Lead: <strong><%= story.createdBy ? story.createdBy.name : 'Unknown' %></strong> · 
                                    Published: <%= formatDate(story.createdAt) %>
                                </div>
                            </div>
                            <span style="background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">
                                ✓ PUBLISHED
                            </span>
                        </div>

                        <p style="font-size: 13.5px; color: #334155; margin: 0 0 14px 0; font-style: italic; background: #f8fafc; padding: 12px 14px; border-radius: 8px; border: 1px solid #e2e8f0;">
                            "<%= story.summary %>"
                        </p>

                        <div style="display: flex; justify-content: flex-end;">
                            <form action="/admin/stories/<%= story._id %>/reject" method="POST" style="margin: 0;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn-small-outline" style="border-color: #fca5a5; color: #dc2626; padding: 6px 14px; font-size: 12.5px; border-radius: 6px; cursor: pointer; background: white;">
                                    Unpublish / Remove
                                </button>
                            </form>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div style="background: white; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 32px; text-align: center; color: #64748b; font-size: 14px;">
                No approved success stories published yet.
            </div>
        <% } %>
    </div>

</div>
