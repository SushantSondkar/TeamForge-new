<% layout("/layouts/boilerplate") -%>

<div class="admin-organizers-page page-container" style="max-width: 1100px;">

    <div style="margin-bottom: 20px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <h1 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 0;">Admin: Campus Management</h1>
            <span style="background: #ef4444; color: white; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px; text-transform: uppercase;">ADMIN ONLY</span>
        </div>
        <p style="color: #64748b; font-size: 14px; margin: 6px 0 0 0;">
            Review and decide student organizer applications with faculty verification, and manage campus competition privileges.
        </p>
    </div>

    <!-- Admin Subnav Tabs -->
    <div style="display: flex; gap: 12px; margin-bottom: 24px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
        <a href="/admin/organizers" style="padding: 8px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; background: #2563eb; color: white;">
            Organizer Requests (<%= pendingApplications ? pendingApplications.length : 0 %>)
        </a>
        <a href="/admin/stories" style="padding: 8px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; background: #f1f5f9; color: #475569;">
            Success Stories
        </a>
    </div>

    <!-- Section 1: Pending Applications -->
    <div style="margin-bottom: 36px;">
        <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            Pending Applications 
            <span style="background: #fef3c7; color: #b45309; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">
                <%= pendingApplications ? pendingApplications.length : 0 %>
            </span>
        </h2>

        <% if (pendingApplications && pendingApplications.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <% pendingApplications.forEach(app => { %>
                    <% const applicant = app.applicantId || {}; %>
                    <% const isSelf = applicant._id && currentUser && applicant._id.toString() === currentUser._id.toString(); %>
                    <div style="background: white; border: 1px solid #fed7aa; border-left: 4px solid #f97316; border-radius: 12px; padding: 22px 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.03);">
                        
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 14px; margin-bottom: 14px;">
                            <div>
                                <h3 style="font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 4px 0;">
                                    <%= app.organizationName %>
                                </h3>
                                <div style="font-size: 13px; color: #64748b;">
                                    Applicant: <strong style="color: #1e293b;"><%= applicant.name || 'Student' %></strong> (<%= applicant.email || 'N/A' %>) · 
                                    Department: <strong><%= app.department || applicant.department || 'N/A' %></strong> · 
                                    Role: <strong><%= app.applicantRole || 'Member' %></strong>
                                </div>
                            </div>
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="background: #ffedd5; color: #c2410c; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">
                                    PENDING REVIEW
                                </span>
                            </div>
                        </div>

                        <!-- Details Grid -->
                        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px 18px; margin-bottom: 16px; font-size: 13px; color: #334155; line-height: 1.55;">
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 10px; margin-bottom: 10px; border-bottom: 1px solid #e2e8f0; padding-bottom: 10px;">
                                <div>
                                    <span style="color: #64748b; font-weight: 600;">Faculty Coordinator:</span> 
                                    <strong><%= app.facultyCoordinatorName %></strong>
                                </div>
                                <div>
                                    <span style="color: #64748b; font-weight: 600;">Coordinator Email:</span> 
                                    <a href="mailto:<%= app.facultyCoordinatorEmail %>" style="color: #2563eb; text-decoration: none;"><%= app.facultyCoordinatorEmail %></a>
                                </div>
                            </div>

                            <div style="margin-bottom: 10px;">
                                <strong style="color: #475569;">Planned Event Details & Dates:</strong>
                                <p style="margin: 4px 0 0 0; color: #1e293b;"><%= app.plannedEventDetails %></p>
                            </div>

                            <div style="margin-bottom: 10px;">
                                <strong style="color: #475569;">Proof / Authorization Document:</strong>
                                <% if (app.proofLink && (app.proofLink.startsWith('http://') || app.proofLink.startsWith('https://'))) { %>
                                    <a href="<%= app.proofLink %>" target="_blank" rel="noopener noreferrer" style="color: #2563eb; text-decoration: underline; font-weight: 600; margin-left: 6px;">
                                        View Submitted Proof Link &rarr;
                                    </a>
                                <% } else { %>
                                    <span style="color: #94a3b8; font-style: italic; margin-left: 6px;">No valid HTTP/HTTPS link provided</span>
                                <% } %>
                            </div>

                            <div>
                                <strong style="color: #475569;">Reason for Request:</strong>
                                <p style="margin: 4px 0 0 0; color: #1e293b;"><%= app.reason %></p>
                            </div>
                        </div>

                        <!-- Actions Section -->
                        <% if (isSelf) { %>
                            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 8px; padding: 10px 14px; color: #991b1b; font-size: 13px; font-weight: 600; display: flex; align-items: center; justify-content: space-between;">
                                <span>⚠️ Self-Approval Blocked: You submitted this organizer application. Another administrator must review and decide it.</span>
                            </div>
                        <% } else { %>
                            <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 14px; border-top: 1px solid #f1f5f9; padding-top: 14px;">
                                <!-- Reject Form with Required Reason -->
                                <form action="/admin/organizers/<%= app._id %>/reject" method="POST" style="margin: 0; flex: 1; max-width: 580px;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <div style="display: flex; gap: 8px; align-items: center;">
                                        <input type="text" name="rejectionReason" required maxlength="500"
                                               placeholder="Reason for rejection (required, max 500 chars)..." 
                                               style="flex: 1; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px; box-sizing: border-box;">
                                        <button type="submit" class="btn-small-outline" style="border-color: #fca5a5; color: #dc2626; padding: 8px 14px; font-size: 13px; border-radius: 6px; cursor: pointer; background: white; white-space: nowrap;">
                                            Reject
                                        </button>
                                    </div>
                                </form>

                                <!-- Approve Form -->
                                <form action="/admin/organizers/<%= app._id %>/approve" method="POST" style="margin: 0;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="btn-small-primary" style="background: #16a34a; border-color: #16a34a; padding: 8px 20px; font-size: 13px; border-radius: 6px; cursor: pointer; white-space: nowrap;">
                                        ✓ Approve Organizer
                                    </button>
                                </form>
                            </div>
                        <% } %>

                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; text-align: center; color: #64748b; font-size: 14px;">
                No pending organizer applications. All caught up!
            </div>
        <% } %>
    </div>

    <!-- Section 2: Approved Organizers -->
    <div style="margin-bottom: 36px;">
        <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            Approved Campus Organizers
            <span style="background: #dcfce7; color: #15803d; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">
                <%= (approvedApplications ? approvedApplications.length : 0) + (legacyApprovedOrganizers ? legacyApprovedOrganizers.length : 0) %>
            </span>
        </h2>

        <% const hasApproved = (approvedApplications && approvedApplications.length > 0) || (legacyApprovedOrganizers && legacyApprovedOrganizers.length > 0); %>
        <% if (hasApproved) { %>
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 12px; text-transform: uppercase;">
                            <th style="padding: 12px 18px;">Organization</th>
                            <th style="padding: 12px 18px;">Lead Contact</th>
                            <th style="padding: 12px 18px;">Department</th>
                            <th style="padding: 12px 18px;">Faculty Coordinator</th>
                            <th style="padding: 12px 18px; text-align: center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (approvedApplications) { %>
                            <% approvedApplications.forEach(app => { %>
                                <% const applicant = app.applicantId || {}; %>
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 14px 18px; font-weight: 700; color: #0f172a;">
                                        <%= app.organizationName %>
                                    </td>
                                    <td style="padding: 14px 18px; color: #334155;">
                                        <%= applicant.name || 'Organizer' %> (<%= applicant.email || 'N/A' %>)
                                    </td>
                                    <td style="padding: 14px 18px; color: #64748b;">
                                        <%= app.department || applicant.department || 'N/A' %>
                                    </td>
                                    <td style="padding: 14px 18px; color: #64748b;">
                                        <%= app.facultyCoordinatorName || 'N/A' %> (<%= app.facultyCoordinatorEmail || 'N/A' %>)
                                    </td>
                                    <td style="padding: 14px 18px; text-align: center;">
                                        <span style="background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 10px;">
                                            APPROVED
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>

                        <% if (legacyApprovedOrganizers) { %>
                            <% legacyApprovedOrganizers.forEach(org => { %>
                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td style="padding: 14px 18px; font-weight: 700; color: #0f172a;">
                                        <%= org.organizationName || 'Campus Chapter' %>
                                    </td>
                                    <td style="padding: 14px 18px; color: #334155;">
                                        <%= org.name %> (<%= org.email %>)
                                    </td>
                                    <td style="padding: 14px 18px; color: #64748b;">
                                        <%= org.department || 'N/A' %>
                                    </td>
                                    <td style="padding: 14px 18px; color: #94a3b8; font-style: italic;">
                                        Grandfathered
                                    </td>
                                    <td style="padding: 14px 18px; text-align: center;">
                                        <span style="background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 10px;">
                                            APPROVED
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; text-align: center; color: #64748b; font-size: 13.5px;">
                No approved campus organizers yet.
            </div>
        <% } %>
    </div>

    <!-- Section 3: Recently Decided / Rejected Applications -->
    <% if (rejectedApplications && rejectedApplications.length > 0) { %>
        <div style="margin-bottom: 36px;">
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
                Decided / Rejected Applications
                <span style="background: #fee2e2; color: #b91c1c; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">
                    <%= rejectedApplications.length %>
                </span>
            </h2>

            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13px;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 11.5px; text-transform: uppercase;">
                            <th style="padding: 12px 16px;">Organization</th>
                            <th style="padding: 12px 16px;">Applicant</th>
                            <th style="padding: 12px 16px;">Rejection Reason</th>
                            <th style="padding: 12px 16px;">Decided On</th>
                            <th style="padding: 12px 16px; text-align: center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% rejectedApplications.forEach(app => { %>
                            <% const applicant = app.applicantId || {}; %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 12px 16px; font-weight: 600; color: #0f172a;">
                                    <%= app.organizationName %>
                                </td>
                                <td style="padding: 12px 16px; color: #334155;">
                                    <%= applicant.name || 'Student' %> (<%= applicant.email || 'N/A' %>)
                                </td>
                                <td style="padding: 12px 16px; color: #b91c1c;">
                                    <%= app.rejectionReason || 'No reason specified' %>
                                </td>
                                <td style="padding: 12px 16px; color: #64748b;">
                                    <%= app.reviewedAt ? new Date(app.reviewedAt).toLocaleDateString() : 'Recent' %>
                                </td>
                                <td style="padding: 12px 16px; text-align: center;">
                                    <span style="background: #fee2e2; color: #b91c1c; font-size: 11px; font-weight: 700; padding: 2px 7px; border-radius: 8px;">
                                        REJECTED
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    <% } %>

</div>
