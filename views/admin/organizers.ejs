<% layout("/layouts/boilerplate") -%>

<div class="admin-organizers-page" style="padding: 24px 36px; max-width: 1100px; margin: 0 auto;">

    <div style="margin-bottom: 20px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <h1 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 0;">Admin: Campus Management</h1>
            <span style="background: #ef4444; color: white; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px; text-transform: uppercase;">ADMIN ONLY</span>
        </div>
        <p style="color: #64748b; font-size: 14px; margin: 6px 0 0 0;">
            Review and approve club and department organizer accounts and hackathon team success stories.
        </p>
    </div>

    <!-- Admin Subnav Tabs -->
    <div style="display: flex; gap: 12px; margin-bottom: 24px; border-bottom: 1px solid #e2e8f0; padding-bottom: 12px;">
        <a href="/admin/organizers" style="padding: 8px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; background: #2563eb; color: white;">
            Organizer Requests (<%= pendingOrganizers ? pendingOrganizers.length : 0 %>)
        </a>
        <a href="/admin/stories" style="padding: 8px 16px; border-radius: 8px; font-size: 13.5px; font-weight: 600; text-decoration: none; background: #f1f5f9; color: #475569;">
            Success Stories
        </a>
    </div>

    <!-- Section 1: Pending Applications -->
    <div style="margin-bottom: 36px;">
        <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            Pending Applications 
            <span style="background: #fef3c7; color: #b45309; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">
                <%= pendingOrganizers ? pendingOrganizers.length : 0 %>
            </span>
        </h2>

        <% if (pendingOrganizers && pendingOrganizers.length > 0) { %>
            <div style="display: flex; flex-direction: column; gap: 14px;">
                <% pendingOrganizers.forEach(applicant => { %>
                    <div style="background: white; border: 1px solid #fed7aa; border-left: 4px solid #f97316; border-radius: 12px; padding: 20px 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.03);">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 14px; margin-bottom: 12px;">
                            <div>
                                <h3 style="font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 4px 0;">
                                    <%= applicant.organizationName || 'Unnamed Organization' %>
                                </h3>
                                <div style="font-size: 13px; color: #64748b;">
                                    Applicant: <strong><%= applicant.name %></strong> (<%= applicant.email %>) · <%= applicant.department || 'General' %>
                                </div>
                            </div>
                            <span style="background: #ffedd5; color: #c2410c; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">
                                PENDING REVIEW
                            </span>
                        </div>

                        <% if (applicant.organizerReason) { %>
                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 16px; font-size: 13.5px; color: #334155; margin-bottom: 16px; line-height: 1.5;">
                                <strong>Reason / Scope:</strong> <%= applicant.organizerReason %>
                            </div>
                        <% } %>

                        <div style="display: flex; justify-content: flex-end; gap: 10px;">
                            <form action="/admin/organizers/<%= applicant._id %>/reject" method="POST" style="margin: 0;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn-small-outline" style="border-color: #fca5a5; color: #dc2626; padding: 8px 16px; font-size: 13px; border-radius: 6px; cursor: pointer; background: white;">
                                    Reject Application
                                </button>
                            </form>
                            <form action="/admin/organizers/<%= applicant._id %>/approve" method="POST" style="margin: 0;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn-small-primary" style="background: #16a34a; border-color: #16a34a; padding: 8px 18px; font-size: 13px; border-radius: 6px; cursor: pointer;">
                                    ✓ Approve Organizer
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 24px; text-align: center; color: #64748b; font-size: 14px;">
                No pending organizer applications. All caught up!
            </div>
        <% } %>
    </div>

    <!-- Section 2: Approved Organizers -->
    <div style="margin-bottom: 36px;">
        <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 14px; display: flex; align-items: center; gap: 8px;">
            Approved Campus Organizers
            <span style="background: #dcfce7; color: #15803d; font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">
                <%= approvedOrganizers ? approvedOrganizers.length : 0 %>
            </span>
        </h2>

        <% if (approvedOrganizers && approvedOrganizers.length > 0) { %>
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 13.5px;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 12px; text-transform: uppercase;">
                            <th style="padding: 12px 18px;">Organization</th>
                            <th style="padding: 12px 18px;">Lead / Contact</th>
                            <th style="padding: 12px 18px;">Department</th>
                            <th style="padding: 12px 18px; text-align: center;">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% approvedOrganizers.forEach(org => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9;">
                                <td style="padding: 14px 18px; font-weight: 700; color: #0f172a;">
                                    <%= org.organizationName || 'Unnamed' %>
                                </td>
                                <td style="padding: 14px 18px; color: #334155;">
                                    <%= org.name %> (<%= org.email %>)
                                </td>
                                <td style="padding: 14px 18px; color: #64748b;">
                                    <%= org.department || 'N/A' %>
                                </td>
                                <td style="padding: 14px 18px; text-align: center;">
                                    <span style="background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 10px;">
                                        APPROVED
                                    </span>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; text-align: center; color: #64748b; font-size: 13.5px;">
                No approved organizers yet.
            </div>
        <% } %>
    </div>

</div>
