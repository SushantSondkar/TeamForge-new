<aside class="sidebar" id="appSidebar">

    <!-- Mobile Drawer Header (Hidden on Desktop) -->
    <div class="sidebar-mobile-header" style="display: none; align-items: center; justify-content: space-between; padding: 12px 16px; margin-bottom: 10px; border-bottom: 1px solid #f1f5f9;">
        <span style="font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.05em;">Navigation</span>
        <button type="button" class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close navigation drawer">
            ✕
        </button>
    </div>

    <nav class="sidebar-nav" style="padding: 10px 15px;">

        <% if (currentUser) { %>
            <a href="/dashboard" class="sidebar-link" style="color: #475569; font-weight: 500; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: block; text-decoration: none; transition: all 0.15s ease;">
                <span>Dashboard</span>
            </a>

            <a href="/events" class="sidebar-link" style="color: #475569; font-weight: 500; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: block; text-decoration: none; transition: all 0.15s ease;">
                <span>Events & Hackathons</span>
            </a>

            <a href="/discover" class="sidebar-link" style="color: #475569; font-weight: 500; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: block; text-decoration: none; transition: all 0.15s ease;">
                <span>Discover Opportunities</span>
            </a>

            <a href="/notifications" class="sidebar-link" style="color: #475569; font-weight: 500; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center; text-decoration: none; transition: all 0.15s ease;">
                <span>Notifications</span>
                <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %>
                    <span style="background-color: #ef4444; color: white; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 12px;"><%= unreadNotificationCount > 99 ? '99+' : unreadNotificationCount %></span>
                <% } %>
            </a>

            <a href="/profile" class="sidebar-link" style="color: #475569; font-weight: 500; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: block; text-decoration: none; transition: all 0.15s ease;">
                <span>Profile & Settings</span>
            </a>

            <% if (currentUser.isAdmin) { %>
            <a href="/admin/stats" class="sidebar-link" style="color: #1e3a8a; font-weight: 600; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: block; text-decoration: none; transition: all 0.15s ease;">
                <span>Live Stats (Admin)</span>
            </a>
            <% } %>
        <% } else { %>
            <a href="/events" class="sidebar-link" style="color: #475569; font-weight: 500; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: block; text-decoration: none; transition: all 0.15s ease;">
                <span>Events & Hackathons</span>
            </a>

            <a href="/discover" class="sidebar-link" style="color: #475569; font-weight: 500; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: block; text-decoration: none; transition: all 0.15s ease;">
                <span>Discover Opportunities</span>
            </a>

            <a href="/login" class="sidebar-link" style="color: #475569; font-weight: 500; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: block; text-decoration: none; transition: all 0.15s ease;">
                <span>Log In</span>
            </a>

            <a href="/signup" class="sidebar-link" style="color: #475569; font-weight: 500; border-radius: 8px; margin-bottom: 5px; padding: 12px 16px; display: block; text-decoration: none; transition: all 0.15s ease;">
                <span>Sign Up</span>
            </a>
        <% } %>

    </nav>

</aside>