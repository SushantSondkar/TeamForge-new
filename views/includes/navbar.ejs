<nav class="navbar">

    <div class="navbar-left">
        <a href="/" style="text-decoration: none; display: flex; align-items: center; gap: 8px;">
            <div style="background-color: #3b82f6; color: white; width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 15px;">TF</div>
            <span class="navbar-center" style="font-size: 20px; font-weight: 700; color: #1f2937;">TeamForge</span>
        </a>
    </div>

    <div class="navbar-right" style="display: flex; align-items: center; gap: 16px;">

        <% if (currentUser) { %>
            <a href="/notifications" class="notification" style="position: relative; text-decoration: none; color: inherit; display: flex; align-items: center;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4b5563" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
            </a>

            <a href="/profile" style="text-decoration: none; color: inherit;">
                <div class="user-info">
                    <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Avatar" class="user-avatar" style="border-radius: 50%; object-fit: cover;">
                    <div class="user-details" style="text-align: left;">
                        <strong style="color: #1f2937; font-size: 14px;"><%= currentUser.name %></strong>
                        <span style="color: #6b7280; font-size: 11px;"><%= currentUser.role || 'Member' %></span>
                    </div>
                </div>
            </a>

            <form action="/logout" method="POST" style="margin: 0;">
                <button type="submit" class="btn-small-outline" style="border-radius: 6px; padding: 6px 12px; font-size: 13px; cursor: pointer;">Logout</button>
            </form>
        <% } else { %>
            <a href="/discover" style="color: #475569; text-decoration: none; font-size: 14px; font-weight: 500;">Discover</a>
            <a href="/login" class="btn-small-outline" style="text-decoration: none; font-size: 13px; padding: 6px 14px;">Log In</a>
            <a href="/signup" class="btn-small-primary" style="text-decoration: none; font-size: 13px; padding: 6px 14px;">Sign Up</a>
        <% } %>

    </div>

</nav>
