<nav class="navbar">
    <div class="navbar-left" style="display: flex; align-items: center; gap: 8px;">
        <% if (typeof hideSidebar === 'undefined' || !hideSidebar) { %>
        <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Open sidebar menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <path d="M9 3v18"></path>
            </svg>
        </button>
        <% } %>
        <a href="/" class="navbar-brand-link" aria-label="TeamForge Home" style="text-decoration: none; display: flex; align-items: center;">
            <img src="/images/logo-horizontal.svg" alt="TeamForge" class="navbar-brand-full">
            <img src="/images/logo-icon.svg" alt="TeamForge" class="navbar-brand-icon">
        </a>
    </div>

    <% if (typeof hideNavOptions === 'undefined' || !hideNavOptions) { %>
    <!-- Mobile Hamburger Toggle -->
    <button class="navbar-mobile-toggle" id="navbarMobileToggle" aria-label="Toggle navigation menu" style="display: none; background: none; border: none; cursor: pointer; padding: 6px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#334155" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
    </button>

    <div class="navbar-right" id="navbarMenu" style="display: flex; align-items: center; gap: 16px;">
        <a href="/landing" class="nav-item-link">Home</a>
        <a href="/leaderboard" class="nav-item-link">Leaderboard</a>

        <% if (currentUser) { %>
            <a href="/reviews" class="nav-item-link">Reviews</a>
            <% if (currentUser.isAdmin) { %>
                <a href="/admin/stats" class="nav-item-link" style="color: #2563eb; font-weight: 600;">Stats</a>
                <a href="/admin/organizers" class="nav-item-link" style="color: #dc2626; font-weight: 600;">Admin</a>
            <% } else { %>
                <a href="/organizer/apply" class="nav-item-link">Organizer</a>
            <% } %>

            <a href="/notifications" class="notification" title="Notifications" style="position: relative; text-decoration: none; color: inherit; display: flex; align-items: center; padding: 6px; border-radius: 8px;" aria-label="Notifications">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#475569" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %>
                    <span class="notification-badge" style="position: absolute; top: -3px; right: -5px; background-color: #ef4444; color: white; font-size: 10px; font-weight: 700; min-width: 17px; height: 17px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; padding: 0 4px; line-height: 1; border: 2px solid #ffffff;"><%= unreadNotificationCount > 99 ? '99+' : unreadNotificationCount %></span>
                <% } %>
            </a>

            <a href="/profile" style="text-decoration: none; color: inherit; display: flex; align-items: center; padding: 4px 8px; border-radius: 8px; transition: background 0.15s ease;" title="Profile & Settings">
                <div class="user-info" style="display: flex; align-items: center; gap: 8px;">
                    <img src="<%= (currentUser && currentUser.profilePic) ? currentUser.profilePic : 'data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 24 24\'%3E%3Ccircle cx=\'12\' cy=\'12\' r=\'12\' fill=\'%23e2e8f0\'/%3E%3Cpath d=\'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\' fill=\'%239ca3af\'/%3E%3C/svg%3E' %>" alt="Avatar" class="user-avatar" style="border-radius: 50%; object-fit: cover; width: 34px; height: 34px; background: #f1f5f9; border: 1.5px solid #e2e8f0;">
                    <div class="user-details" style="text-align: left; line-height: 1.2;">
                        <strong style="color: #0f172a; font-size: 13px; display: block;"><%= currentUser.name %></strong>
                        <span style="color: #64748b; font-size: 11px;"><%= currentUser.role || 'Student' %></span>
                    </div>
                </div>
            </a>

            <form action="/logout" method="POST" style="margin: 0;">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="btn-small-outline" style="border-radius: 6px; padding: 6px 12px; font-size: 13px; cursor: pointer; border: 1px solid #cbd5e1; background: white; color: #475569;">Logout</button>
            </form>
        <% } else { %>
            <a href="/login" class="btn-small-outline" style="text-decoration: none; font-size: 13px; padding: 7px 16px; border: 1px solid #cbd5e1; border-radius: 6px; color: #334155; font-weight: 500;">Log In</a>
            <a href="/signup" class="btn-small-primary" style="text-decoration: none; font-size: 13px; padding: 7px 16px; background: #2563eb; color: white; border-radius: 6px; font-weight: 600; box-shadow: 0 1px 3px rgba(37, 99, 235, 0.3);">Sign Up</a>
        <% } %>
    </div>
    <% } %>
</nav>

