<footer class="app-footer" style="background: #ffffff; border-top: 1px solid #e2e8f0; padding: 24px 20px; margin-top: auto; text-align: center; color: #64748b; font-size: 13px;">
    <div style="max-width: 960px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
        <div style="display: flex; align-items: center; gap: 10px;">
            <img src="/images/logo-icon.svg" alt="TeamForge" style="height: 24px; width: 24px;">
            <span style="font-weight: 600; color: #0f172a;">TeamForge</span>
            <span style="color: #94a3b8;">·</span>
            <span>K.K. Wagh Institute of Engineering Education & Research</span>
        </div>
        <div style="display: flex; align-items: center; gap: 18px; flex-wrap: wrap;">
            <a href="/how-it-works" style="color: #2563eb; text-decoration: none; font-weight: 500;">How TeamForge works</a>
            <% 
              const activeSupportEmail = (typeof supportEmail !== "undefined" && supportEmail) 
                || (typeof process !== "undefined" && process.env && process.env.SUPPORT_EMAIL ? process.env.SUPPORT_EMAIL.trim() : null); 
            %>
            <% if (activeSupportEmail) { %>
            <a href="mailto:<%= activeSupportEmail %>?subject=TeamForge%20Issue%20Report" style="color: #64748b; text-decoration: none; font-weight: 500;">Report a problem</a>
            <% } %>
            <span style="color: #94a3b8;">© 2026 TeamForge</span>
        </div>
    </div>
</footer>