<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' · TeamForge' : 'TeamForge · Campus Hackathon & Project Teaming' %></title>

    <!-- Brand Identity & Favicons -->
    <meta name="theme-color" content="#1E3A8A">
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
    <link rel="icon" type="image/svg+xml" href="/images/logo-icon.svg">
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png">
    <link rel="manifest" href="/site.webmanifest">

    <!-- Open Graph & Social Sharing Meta Tags -->
    <% 
      const metaTitle = typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : (typeof pageTitle !== 'undefined' && pageTitle ? pageTitle + ' · TeamForge' : 'TeamForge · Campus Hackathon & Project Teaming');
      const metaDescription = typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : 'Assemble balanced campus hackathon and engineering project teams based on verified skills, roles, and campus events.';
      const metaBase = typeof appBaseUrl !== 'undefined' && appBaseUrl ? appBaseUrl : '';
      const metaUrl = metaBase + (typeof currentPath !== 'undefined' ? currentPath : '');
      const metaImage = metaBase + '/images/og-image.png';
    %>
    <meta name="description" content="<%= metaDescription %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="TeamForge">
    <meta property="og:title" content="<%= metaTitle %>">
    <meta property="og:description" content="<%= metaDescription %>">
    <meta property="og:url" content="<%= metaUrl %>">
    <meta property="og:image" content="<%= metaImage %>">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= metaTitle %>">
    <meta name="twitter:description" content="<%= metaDescription %>">
    <meta name="twitter:image" content="<%= metaImage %>">

    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <script src="/js/theme-init.js"></script>
    <link rel="stylesheet" href="/css/style.css">
    <% if (typeof extraStyles !== 'undefined') { %>
        <%- extraStyles %>
    <% } %>
</head>

<body>

    <%- include("../includes/navbar") %>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="app-layout <%= (typeof hideSidebar !== 'undefined' && hideSidebar) ? 'app-layout-full' : '' %>">

        <% if (typeof hideSidebar === 'undefined' || !hideSidebar) { %>
            <%- include("../includes/sidebar") %>
        <% } %>

        <main class="main-content <%= (typeof hideSidebar !== 'undefined' && hideSidebar) ? 'main-content-full' : '' %>">
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="flash-alert flash-success" role="alert" style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #166534; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 14px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span>✅</span>
                        <span><%= success %></span>
                    </div>
                    <button type="button" class="flash-alert-close" aria-label="Close alert" style="background: none; border: none; font-size: 18px; line-height: 1; cursor: pointer; color: #166534;">&times;</button>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="flash-alert flash-danger" role="alert" style="background-color: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 14px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span>⚠️</span>
                        <span><%= error %></span>
                    </div>
                    <button type="button" class="flash-alert-close" aria-label="Close alert" style="background: none; border: none; font-size: 18px; line-height: 1; cursor: pointer; color: #991b1b;">&times;</button>
                </div>
            <% } %>

            <%- body %>
        </main>

    </div>

    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <nav class="mobile-bottom-nav" aria-label="Mobile Navigation">
        <a href="/dashboard" class="mobile-nav-item" aria-label="Dashboard">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            <span>Home</span>
        </a>
        <a href="/events" class="mobile-nav-item" aria-label="Events">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
            <span>Events</span>
        </a>
        <a href="/discover" class="mobile-nav-item" aria-label="Discover">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" x2="16.65" y1="21" y2="16.65"></line></svg>
            <span>Discover</span>
        </a>
        <a href="/notifications" class="mobile-nav-item" aria-label="Notifications" style="position: relative;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            <span>Alerts</span>
            <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %>
                <span class="mobile-badge" style="position: absolute; top: 4px; right: calc(50% - 16px); background-color: #ef4444; color: white; font-size: 9px; font-weight: 700; min-width: 14px; height: 14px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; padding: 0 3px; border: 1px solid white;"><%= unreadNotificationCount > 99 ? '99+' : unreadNotificationCount %></span>
            <% } %>
        </a>
        <a href="/profile" class="mobile-nav-item" aria-label="Profile">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>Profile</span>
        </a>
    </nav>
    <% } %>

    <%- include("../includes/footer") %>

    <script src="/js/theme.js"></script>
    <script src="/js/layout.js"></script>

    <% if (typeof extraScripts !== 'undefined') { %>
        <%- extraScripts %>
    <% } %>
</body>
</html>
