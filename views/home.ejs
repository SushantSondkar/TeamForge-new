<% layout("/layouts/boilerplate") -%>

<div class="dashboard-new">

    <!-- Active Team Status -->
    <div class="dashboard-card-new full-width">
        <div class="card-header-new">
            <span class="label-text">ACTIVE TEAM STATUS</span>
            <span class="badge badge-urgent">URGENT</span>
        </div>
        <h2 class="team-title">Alpha_coders</h2>
        
        <div class="team-stats-row">
            <div class="stat-col">
                <span class="stat-label">Current Role Needed</span>
                <span class="stat-value">Lead Technical Architect</span>
            </div>
            <div class="stat-col">
                <span class="stat-label">Total Members</span>
                <span class="stat-value">6 / 8 Active</span>
            </div>
            <div class="stat-col">
                <span class="stat-label">Project Deadline</span>
                <span class="stat-value">October 15, 2026</span>
            </div>
        </div>
    </div>

    <div class="dashboard-grid-new">

        <!-- Recommended Candidates -->
        <div class="dashboard-card-new">
            <h3 class="card-title-new">Recommended Candidates</h3>
            <div class="list-container">
                
                <div class="list-item">
                    <div class="item-main">
                        <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Avatar" class="item-avatar">
                        <div class="item-details">
                            <strong>Harsh Dhavane</strong>
                            <div class="item-meta-row">
                                <span class="tag tag-blue">REACT DEVELOPER</span>
                                <span class="text-green">98% Match</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn-small-primary">Invite</button>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Avatar" class="item-avatar">
                        <div class="item-details">
                            <strong>Gayatri Jadhav</strong>
                            <div class="item-meta-row">
                                <span class="tag tag-blue">PYTHON SPECIALIST</span>
                                <span class="text-green">94% Match</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn-small-primary">Invite</button>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Avatar" class="item-avatar">
                        <div class="item-details">
                            <strong>Sanket Pawar</strong>
                            <div class="item-meta-row">
                                <span class="tag tag-blue">UI-UX DESIGNER</span>
                                <span class="text-green">91% Match</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn-small-primary">Invite</button>
                </div>

            </div>
        </div>

        <!-- Recommended Opportunities -->
        <div class="dashboard-card-new">
            <h3 class="card-title-new">Recommended Opportunities</h3>
            <div class="list-container">
                
                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Team Nexus</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">Frontend Lead</span>
                                <span class="text-blue">97% Match</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn-small-outline">Apply</button>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Agratas</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">Data Scientist</span>
                                <span class="text-blue">93% Match</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn-small-outline">Apply</button>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Opportunity Hunters</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">Creative Lead</span>
                                <span class="text-blue">89% Match</span>
                            </div>
                        </div>
                    </div>
                    <button class="btn-small-outline">Apply</button>
                </div>

            </div>
        </div>

        <!-- Active Invites Sent -->
        <div class="dashboard-card-new">
            <h3 class="card-title-new">Active Invites Sent</h3>
            <div class="list-container">
                
                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Atmaj Gaikwad</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">DevOps Engineer</span>
                            </div>
                        </div>
                    </div>
                    <span class="badge badge-warning">PENDING</span>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Kalpesh Shinde</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">Backend Developer</span>
                            </div>
                        </div>
                    </div>
                    <span class="badge badge-success">ACCEPTED</span>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Bhakti Lad</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">QA Engineer</span>
                            </div>
                        </div>
                    </div>
                    <span class="badge badge-danger">DECLINED</span>
                </div>

            </div>
        </div>

        <!-- New Invites Received -->
        <div class="dashboard-card-new">
            <h3 class="card-title-new">New Invites Received</h3>
            <div class="list-container">
                
                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Team Vortex</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">Senior Developer</span>
                            </div>
                        </div>
                    </div>
                    <div class="action-buttons-small">
                        <button class="btn-small-primary">Accept</button>
                        <button class="btn-small-outline">Decline</button>
                    </div>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>ByteCraft</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">Product Manager</span>
                            </div>
                        </div>
                    </div>
                    <div class="action-buttons-small">
                        <button class="btn-small-primary">Accept</button>
                        <button class="btn-small-outline">Decline</button>
                    </div>
                </div>

            </div>
        </div>

        <!-- Pending Applications -->
        <div class="dashboard-card-new">
            <h3 class="card-title-new">Pending Applications</h3>
            <div class="list-container">
                
                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Team Jalvedh</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">Rust Engineer</span>
                            </div>
                        </div>
                    </div>
                    <span class="badge badge-warning">UNDER REVIEW</span>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Krypton Web</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">UI Designer</span>
                            </div>
                        </div>
                    </div>
                    <span class="badge badge-info">INTERVIEWING</span>
                </div>

            </div>
        </div>

        <!-- Event Deadlines -->
        <div class="dashboard-card-new">
            <h3 class="card-title-new">Event Deadlines</h3>
            <div class="list-container">
                
                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>PCCOE Hackathon Phase 1 Submission</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">2 Hours Remaining</span>
                            </div>
                        </div>
                    </div>
                    <span class="badge badge-urgent">URGENT</span>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Aithon Hackathon (Sangamner)</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">2 Days Left</span>
                            </div>
                        </div>
                    </div>
                    <span class="badge badge-warning">CLOSING SOON</span>
                </div>

                <div class="list-item">
                    <div class="item-main">
                        <div class="item-details">
                            <strong>Open Source Contribution Day</strong>
                            <div class="item-meta-row">
                                <span class="text-gray">1 Week Left</span>
                            </div>
                        </div>
                    </div>
                    <span class="badge badge-success-light">OPEN</span>
                </div>

            </div>
        </div>

    </div>

    <!-- Bottom Actions -->
    <div class="bottom-actions-row">
        <a href="/team-requirement/new" class="btn-large-primary">+ Create Team Requirement</a>
        <a href="/discover" class="btn-large-outline">Browse Opportunities</a>
    </div>

</div>
<script src='/js/dashboard.js'></script>

