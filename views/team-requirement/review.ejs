<% layout("/layouts/boilerplate") -%>

    <div class="team-requirement-page">

        <!-- Top Stepper Card -->
        <div class="stepper-card-new">
            <div class="stepper-new">
                <div class="step-new completed">
                    <div class="step-circle" style="background-color: #3b82f6; color: white; border-color: #3b82f6;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <span class="step-label" style="color: #3b82f6;">Context</span>
                </div>
                <div class="step-line-new" style="background-color: #3b82f6;"></div>
                <div class="step-new completed">
                    <div class="step-circle" style="background-color: #3b82f6; color: white; border-color: #3b82f6;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <span class="step-label" style="color: #3b82f6;">Team Details</span>
                </div>
                <div class="step-line-new" style="background-color: #3b82f6;"></div>
                <div class="step-new completed">
                    <div class="step-circle" style="background-color: #3b82f6; color: white; border-color: #3b82f6;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                    </div>
                    <span class="step-label" style="color: #3b82f6;">Open Roles</span>
                </div>
                <div class="step-line-new" style="background-color: #3b82f6;"></div>
                <div class="step-new active">
                    <div class="step-circle" style="border-color: #3b82f6; color: #3b82f6;">4</div>
                    <span class="step-label" style="color: #3b82f6;">Review & Send</span>
                </div>
            </div>
        </div>

        <!-- Main Content Card -->
        <div class="content-card-new" style="background: transparent; border: none; box-shadow: none; padding: 0;">
            <span class="step-indicator" style="padding-left: 20px;">STEP 4 OF 4: REVIEW & SEND</span>
            <h1 class="page-title-new" style="padding-left: 20px;">Review & Send</h1>

            <form method="POST" class="review-form">
                <!-- Hidden inputs carrying all wizard data -->
                <input type="hidden" name="theme" value="<%= teamData.theme %>">
                <input type="hidden" name="projectName" value="<%= teamData.projectName %>">
                <input type="hidden" name="projectRequirement" value="<%= teamData.projectRequirement %>">
                <input type="hidden" name="deliverables" value="<%= teamData.deliverables %>">
                <input type="hidden" name="teamSize" value="<%= teamData.teamSize %>">
                <input type="hidden" name="deadline" value="<%= teamData.deadline %>">
                <input type="hidden" name="rolesJson" value="<%= (typeof teamData.rolesJson === 'string' && teamData.rolesJson) ? teamData.rolesJson : JSON.stringify(roles || []) %>">

                <div class="review-layout">

                    <div class="review-main-column">
                        <div class="review-card-new">

                            <div class="review-section-new">
                                <div class="section-header">
                                    <span class="section-label">SELECTED CONTEXT</span>
                                    <span class="badge tag-blue" style="text-transform: uppercase;">
                                        <%= teamData.theme || 'HACKATHON' %>
                                    </span>
                                </div>
                                <button type="submit" formaction="/team-requirement/new" class="edit-link" style="background: none; border: none; cursor: pointer; color: #3b82f6; font-size: 14px; font-weight: 500;">Edit</button>
                            </div>

                            <div class="review-section-new">
                                <div class="section-header">
                                    <span class="section-label">TEAM DETAILS</span>
                                </div>
                                <button type="submit" formaction="/team-requirement/new/define-team" class="edit-link" style="background: none; border: none; cursor: pointer; color: #3b82f6; font-size: 14px; font-weight: 500;">Edit</button>

                                <div class="team-details-content">
                                    <h3>
                                        <%= teamData.projectName || 'Untitled Project' %>
                                    </h3>
                                    <strong>
                                        <%= teamData.projectRequirement || '' %>
                                    </strong>
                                    <p>
                                        <%= teamData.deliverables || '' %>
                                    </p>

                                    <div class="team-stats-mini">
                                        <div>
                                            <span class="stat-label-mini">Team Size</span>
                                            <span class="stat-value-mini">
                                                <%= teamData.teamSize || '4' %> members
                                            </span>
                                        </div>
                                        <div>
                                            <span class="stat-label-mini">Current Members</span>
                                            <div class="avatar-group-mini">
                                                <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Avatar">
                                                <span class="avatar-more">+1</span>
                                            </div>
                                        </div>
                                        <div>
                                            <span class="stat-label-mini">Project Deadline</span>
                                            <span class="stat-value-mini">
                                                <% 
                                                    let displayDate = teamData.deadline || '';
                                                    try {
                                                        const d = new Date(teamData.deadline);
                                                        if (!isNaN(d.getTime())) {
                                                            displayDate = d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
                                                        }
                                                    } catch(e) {}
                                                %>
                                                <%= displayDate %>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="review-section-new" style="border-bottom: none;">
                                <div class="section-header">
                                    <span class="section-label">OPEN ROLES SUMMARIES</span>
                                </div>
                                <button type="submit" formaction="/team-requirement/new/open-roles" class="edit-link" style="background: none; border: none; cursor: pointer; color: #3b82f6; font-size: 14px; font-weight: 500;">Edit</button>

                                <% if (roles && roles.length > 0) { %>
                                    <% roles.forEach((r, index) => { %>
                                        <div class="role-summary-card">
                                            <div class="role-summary-header">
                                                <span class="role-number"
                                                    <%- index > 0 ? 'style="width:24px; height:24px; font-size:12px; background-color: #dbeafe; color: #2563eb;"' : 'style="width:24px; height:24px; font-size:12px;"' %>>
                                                    <%= index + 1 %>
                                                </span>
                                                <strong>
                                                    <%= r.title %>
                                                </strong>
                                                <span class="badge badge-success-light" style="margin-left: auto;">
                                                    <%= r.openings || 1 %> Opening<%= (r.openings && r.openings > 1) ? 's' : '' %>
                                                </span>
                                            </div>

                                            <div class="role-summary-row">
                                                <span class="row-label">Required skills:</span>
                                                <div class="row-tags">
                                                    <% if (r.requiredSkills && r.requiredSkills.length > 0) { %>
                                                        <% r.requiredSkills.forEach(skill => { %>
                                                            <span class="skill-tag-small">
                                                                <%= skill %>
                                                            </span>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <span style="font-size: 13px; color: #94a3b8;">None specified</span>
                                                    <% } %>
                                                </div>
                                            </div>

                                            <% if (r.preferredSkills && r.preferredSkills.length > 0) { %>
                                                <div class="role-summary-row">
                                                    <span class="row-label">Preferred skills:</span>
                                                    <div class="row-tags">
                                                        <% r.preferredSkills.forEach(skill => { %>
                                                            <span class="skill-tag-small">
                                                                <%= skill %>
                                                            </span>
                                                        <% }); %>
                                                    </div>
                                                </div>
                                            <% } %>

                                            <div class="role-summary-row" style="margin-top: 10px;">
                                                <span class="row-label">Minimum Proficiency:</span>
                                                <strong>
                                                    <%= r.proficiency || 'Intermediate' %>
                                                </strong>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div style="padding: 20px; color: #64748b;">No roles defined.</div>
                                <% } %>

                            </div>
                        </div>

                        <!-- Candidates Preview -->
                        <h3 class="card-title-new" style="margin: 30px 0 15px 20px;">Potential Candidate Matches</h3>
                        <div class="dashboard-card-new" style="padding: 15px;">
                            <div class="list-item">
                                <div class="item-main">
                                    <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Avatar" class="item-avatar">
                                    <div class="item-details">
                                        <strong>Harsh Dhavane</strong>
                                        <div class="item-meta-row">
                                            <span class="tag tag-blue">CANDIDATE</span>
                                            <span class="text-green">98% Match</span>
                                        </div>
                                    </div>
                                </div>
                                <span class="badge badge-info">PREVIEW</span>
                            </div>
                        </div>
                    </div>

                    <div class="review-sidebar">
                        <div class="invite-sidebar-card">
                            <div class="invite-header">
                                <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Harsh" class="invite-avatar">
                                <span class="invite-title">Reviewing Team: <strong><%= teamData.projectName %></strong></span>
                            </div>

                            <div class="invite-reason">
                                <span class="sidebar-label">PUBLICATION STATUS</span>
                                <div class="reason-box">Ready to post to MongoDB and discoverable by candidates</div>
                            </div>

                            <p style="font-size: 13px; color: #64748b; line-height: 1.5; margin-bottom: 20px;">
                                Once published, your team will appear on the Dashboard and in the Discover catalog.
                            </p>
                        </div>
                    </div>

                </div>

                <div class="form-footer-new" style="margin-top: 30px;">
                    <button type="submit" formaction="/team-requirement/new/open-roles" class="btn-cancel" style="background: white; border: 1px solid #d1d5db; border-radius: 8px; cursor: pointer; padding: 10px 24px; color: #4b5563;">Back</button>
                    <button type="submit" formaction="/team-requirement/submit" class="btn-continue">Finish & Create Team</button>
                </div>

            </form>

        </div>

    </div>
    <script src='/js/team-requirement.js'></script>