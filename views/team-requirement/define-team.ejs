<% layout("/layouts/boilerplate") -%>

<div class="team-requirement-page">

    <!-- Top Stepper Card -->
    <div class="stepper-card-new">
        <div class="stepper-new">
            <div class="step-new completed">
                <div class="step-circle" style="background-color: #3b82f6; color: white; border-color: #3b82f6;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span class="step-label" style="color: #3b82f6;">Context</span>
            </div>
            <div class="step-line-new" style="background-color: #3b82f6;"></div>
            <div class="step-new active">
                <div class="step-circle" style="border-color: #3b82f6; color: #3b82f6;">2</div>
                <span class="step-label" style="color: #3b82f6;">Team Details</span>
            </div>
            <div class="step-line-new"></div>
            <div class="step-new">
                <div class="step-circle">3</div>
                <span class="step-label">Open Roles</span>
            </div>
            <div class="step-line-new"></div>
            <div class="step-new">
                <div class="step-circle">4</div>
                <span class="step-label">Review & Send</span>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="content-card-new">
        <span class="step-indicator">STEP 2 OF 4: TEAM DETAILS</span>
        <h1 class="page-title-new">Define the Team</h1>

        <form action="/team-requirement/new/open-roles" method="POST" class="define-team-form">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <!-- Hidden data from Step 1 and previous edits -->
            <input type="hidden" name="eventId" value="<%= teamData.eventId || '' %>">
            <input type="hidden" name="theme" value="<%= teamData.theme || 'hackathon' %>">
            <input type="hidden" name="rolesJson" value="<%= teamData.rolesJson || '' %>">
            <input type="hidden" name="existingMembersJson" id="existingMembersJson" value="<%= (typeof teamData !== 'undefined' && teamData.existingMembersJson) ? teamData.existingMembersJson : '[]' %>">

            <div class="form-group-new">
                <label>Project Name</label>
                <input type="text" name="projectName" value="<%= teamData.projectName || '' %>" placeholder="e.g. Synergy Core Alpha" class="form-control-new" required>
            </div>

            <div class="form-group-new">
                <label>Problem Statement</label>
                <input type="text" name="projectRequirement" value="<%= teamData.projectRequirement || '' %>" placeholder="One sentence describing the problem you're solving" class="form-control-new" required>
            </div>

            <div class="form-group-new">
                <label>Description / Deliverables</label>
                <textarea name="deliverables" rows="4" placeholder="Explain the project in more detail" class="form-control-new" required><%= teamData.deliverables || '' %></textarea>
            </div>

            <div class="form-group-new">
                <label>Team Size</label>
                <div class="team-size-control-new">
                    <button type="button" class="size-btn-new" onclick="const el = document.getElementById('team-size'); if(parseInt(el.value) > 1) el.stepDown();">−</button>
                    <input type="number" id="team-size" name="teamSize" value="<%= teamData.teamSize || 4 %>" min="1" max="20" class="size-input-new" readonly>
                    <button type="button" class="size-btn-new" onclick="const el = document.getElementById('team-size'); if(parseInt(el.value) < 20) el.stepUp();">+</button>
                    <span class="size-helper">1–20 members</span>
                </div>
            </div>

            <div class="form-group-new">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <label style="margin: 0;">Current Members (<span id="member-count-label">1</span>)</label>
                    <span style="font-size: 12px; color: #64748b;">Confirmed team roster</span>
                </div>

                <div class="member-list-new" id="member-list-container">
                    <!-- Team Creator (Always Lead Coordinator) -->
                    <div class="member-item-new" style="background-color: #f8fafc; border-color: #cbd5e1;">
                        <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Avatar" class="member-avatar-new">
                        <div class="member-info-new">
                            <strong style="color: #0f172a;"><%= currentUser ? currentUser.name : 'You' %> (You)</strong>
                            <span class="member-role-badge" style="background: #e0f2fe; color: #0369a1; font-weight: 600; padding: 3px 10px; border-radius: 12px; font-size: 11.5px;">Lead Coordinator</span>
                        </div>
                    </div>

                    <!-- Dynamic container for additional existing teammates -->
                    <div id="additional-members-list" style="display: flex; flex-direction: column; gap: 8px;"></div>
                </div>

                <!-- Add existing teammate input row -->
                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; padding: 14px; margin-top: 10px;">
                    <span style="display: block; font-size: 12.5px; font-weight: 700; color: #334155; margin-bottom: 8px;">
                        + Add a Teammate Already in This Team
                    </span>
                    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                        <input type="text" id="new-member-name" placeholder="Teammate Full Name (e.g. Sneha Patel)" class="form-control-new" style="flex: 1.5; min-width: 180px; margin-bottom: 0;">
                        <input type="text" id="new-member-role" placeholder="Role (e.g. Frontend Lead, ML Dev)" class="form-control-new" style="flex: 1; min-width: 140px; margin-bottom: 0;">
                        <button type="button" id="btn-add-existing-member" class="btn-small-primary" style="padding: 9px 18px; font-size: 13px; border-radius: 6px; white-space: nowrap; cursor: pointer;">
                            Add Member
                        </button>
                    </div>
                </div>

                <p style="font-size: 12px; color: #64748b; margin-top: 8px;">
                    Add any classmates or peers who have already agreed to join your team. In Step 3, you'll specify the open roles you still need to recruit for.
                </p>
            </div>

            <% 
                let formattedDeadline = '';
                if (teamData.deadline) {
                    const d = new Date(teamData.deadline);
                    if (!isNaN(d.getTime())) {
                        formattedDeadline = d.toISOString().split('T')[0];
                    } else if (typeof teamData.deadline === 'string' && teamData.deadline.includes('-')) {
                        formattedDeadline = teamData.deadline.split('T')[0];
                    }
                }
            %>

            <div class="form-group-new">
                <label>Event/Project Deadline</label>
                <div class="date-input-wrapper">
                    <input type="date" name="deadline" value="<%= formattedDeadline %>" class="form-control-new" required>
                </div>
                <p class="helper-text-new">* Note: This deadline date is used to dynamically flag high-priority team construction and automatically calculate team formation urgency in the next steps.</p>
            </div>

            <div class="form-footer-new">
                <div class="footer-actions">
                    <button type="submit" formaction="/team-requirement/new" class="btn-cancel" style="background: none; border: 1px solid #d1d5db; border-radius: 8px; cursor: pointer; padding: 10px 24px; color: #4b5563;">Back</button>
                    <button type="submit" class="btn-continue">Continue</button>
                </div>
            </div>

        </form>
    </div>

</div>
<script src='/js/team-requirement.js'></script>

