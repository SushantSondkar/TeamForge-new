<% layout("/layouts/boilerplate") -%>

<div class="team-requirement-page">

    <!-- Top Stepper Card -->
    <div class="stepper-card-new">
        <div class="stepper-new">
            <div class="step-new completed">
                <div class="step-circle" style="background-color: #3b82f6; color: white; border-color: #3b82f6;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span class="step-label" style="color: #3b82f6;">Context</span>
            </div>
            <div class="step-line-new" style="background-color: #3b82f6;"></div>
            <div class="step-new completed">
                <div class="step-circle" style="background-color: #3b82f6; color: white; border-color: #3b82f6;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </div>
                <span class="step-label" style="color: #3b82f6;">Team Details</span>
            </div>
            <div class="step-line-new" style="background-color: #3b82f6;"></div>
            <div class="step-new active">
                <div class="step-circle" style="border-color: #3b82f6; color: #3b82f6;">3</div>
                <span class="step-label" style="color: #3b82f6;">Open Roles</span>
            </div>
            <div class="step-line-new"></div>
            <div class="step-new">
                <div class="step-circle">4</div>
                <span class="step-label">Review & Send</span>
            </div>
        </div>
    </div>

    <!-- Main Content Card -->
    <div class="content-card-new">
        <span class="step-indicator">STEP 3 OF 4: OPEN ROLES</span>
        <h1 class="page-title-new">Create Open Roles</h1>

        <form action="/team-requirement/new/review" method="POST" class="open-roles-form">

            <!-- Hidden Inputs from Step 1 & 2 -->
            <input type="hidden" name="theme" value="<%= teamData.theme %>">
            <input type="hidden" name="projectName" value="<%= teamData.projectName %>">
            <input type="hidden" name="projectRequirement" value="<%= teamData.projectRequirement %>">
            <input type="hidden" name="deliverables" value="<%= teamData.deliverables %>">
            <input type="hidden" name="teamSize" value="<%= teamData.teamSize %>">
            <input type="hidden" name="deadline" value="<%= teamData.deadline %>">
            <input type="hidden" name="rolesJson" id="rolesJson" value="<%= teamData.rolesJson || '' %>">

            <div id="roles-container">
            <% 
                const defaultInitialRoles = [
                    {
                        title: 'Lead Technical Architect',
                        requiredSkills: ['System Design', 'Node.js', 'MongoDB'],
                        preferredSkills: ['AWS', 'Docker'],
                        proficiency: 'Advanced',
                        openings: 1
                    }
                ];
                const activeRoles = (roles && roles.length > 0) ? roles : defaultInitialRoles;
            %>

            <% activeRoles.forEach((r, idx) => { %>
                <div class="role-profile-card">
                    <div class="role-profile-header">
                        <div class="role-profile-title">
                            <span class="role-number" <%- idx > 0 ? 'style="background-color: #dbeafe; color: #2563eb;"' : '' %>><%= idx + 1 %></span>
                            <strong>Role Profile</strong>
                        </div>
                        <div class="role-profile-meta" style="display: flex; align-items: center; gap: 12px;">
                            <span class="badge badge-success-light">Urgency: Open</span>
                            <button type="button" class="btn-remove-role" style="background: none; border: none; color: #ef4444; font-size: 13px; font-weight: 600; cursor: pointer; display: <%= activeRoles.length > 1 ? 'inline-block' : 'none' %>;">Remove</button>
                        </div>
                    </div>

                    <div class="form-group-new">
                        <label>Role Title</label>
                        <input type="text" value="<%= r.title || '' %>" placeholder="e.g. Lead Technical Architect" class="form-control-new role-title-input" required>
                    </div>

                    <div class="form-group-new">
                        <label>Required Skills (Press Enter to add)</label>
                        <div class="skills-input-container required-skills-container">
                            <% if (r.requiredSkills && r.requiredSkills.length > 0) { %>
                                <% r.requiredSkills.forEach(skill => { %>
                                    <div class="skill-tag"><%= skill %> <button type="button">×</button></div>
                                <% }); %>
                            <% } %>
                            <input type="text" placeholder="+ Add skill (press Enter)" class="skill-input-transparent">
                        </div>
                    </div>

                    <div class="form-group-new">
                        <label>Preferred Skills (Optional, Press Enter to add)</label>
                        <div class="skills-input-container preferred-skills-container">
                            <% if (r.preferredSkills && r.preferredSkills.length > 0) { %>
                                <% r.preferredSkills.forEach(skill => { %>
                                    <div class="skill-tag"><%= skill %> <button type="button">×</button></div>
                                <% }); %>
                            <% } %>
                            <input type="text" placeholder="+ Add skill (press Enter)" class="skill-input-transparent">
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                        <div class="form-group-new">
                            <label>Minimum Proficiency</label>
                            <select class="form-control-new role-proficiency-select">
                                <option value="Intermediate" <%= (r.proficiency === 'Intermediate' || !r.proficiency) ? 'selected' : '' %>>Intermediate</option>
                                <option value="Advanced" <%= r.proficiency === 'Advanced' ? 'selected' : '' %>>Advanced</option>
                                <option value="Expert" <%= r.proficiency === 'Expert' ? 'selected' : '' %>>Expert</option>
                            </select>
                        </div>

                        <div class="form-group-new">
                            <label>Openings</label>
                            <input type="number" min="1" max="10" value="<%= r.openings || 1 %>" class="form-control-new role-openings-input">
                        </div>
                    </div>
                </div>
            <% }); %>
            </div>

            <button type="button" class="btn-dashed-new btn-add-role" id="btn-add-role">
                + Add another role
            </button>

            <div class="form-footer-new">
                <button type="submit" formaction="/team-requirement/new/define-team" class="btn-cancel" id="btn-back-define-team" style="background: none; border: 1px solid #d1d5db; border-radius: 8px; cursor: pointer; padding: 10px 24px; color: #4b5563;">Back</button>
                <button type="submit" class="btn-continue" id="btn-continue">Continue</button>
            </div>

        </form>
    </div>

</div>
<script src='/js/team-requirement.js'></script>
