<% 
    locals.hideSidebar = true;
    locals.hideNavOptions = true;
-%>
<% layout("/layouts/boilerplate") -%>

<div class="auth-page" style="max-width: 500px; margin: 48px auto; padding: 0 16px;">
    
    <div class="dashboard-card-new" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 36px 30px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04); text-align: center;">
        
        <% if (typeof sendFailed !== 'undefined' && sendFailed) { %>
            <div style="background: #fef2f2; color: #dc2626; width: 56px; height: 56px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 16px; box-shadow: 0 4px 12px rgba(220, 38, 38, 0.12);">
                ⚠️
            </div>
            
            <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0 0 8px 0;">Account Created</h2>
            <div style="background-color: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 12px 14px; border-radius: 8px; font-size: 13.5px; margin-bottom: 20px; text-align: left; display: flex; align-items: center; gap: 8px;">
                <span>⚠️</span>
                <span>Your account was created but we could not send the email. Please use Resend Verification Email.</span>
            </div>
        <% } else { %>
            <div style="background: #eff6ff; color: #2563eb; width: 56px; height: 56px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 16px; box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);">
                ✉️
            </div>
            
            <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0 0 8px 0;">Check Your Inbox</h2>
            <p style="color: #64748b; font-size: 14px; line-height: 1.5; margin: 0 0 20px 0;">
                We've sent an account verification link to your official college email.
            </p>

            <% if (typeof message !== 'undefined' && message) { %>
                <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; padding: 12px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 20px; text-align: left; display: flex; align-items: center; gap: 8px;">
                    <span>✅</span>
                    <span><%= message %></span>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div style="background-color: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 12px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 20px; text-align: left; display: flex; align-items: center; gap: 8px;">
                    <span>⚠️</span>
                    <span><%= error %></span>
                </div>
            <% } %>
        <% } %>

        <% if (typeof email !== 'undefined' && email) { %>
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; padding: 12px 16px; border-radius: 8px; font-size: 14px; font-weight: 600; color: #1e293b; word-break: break-all; margin-bottom: 20px;">
                <%= email %>
            </div>
        <% } %>

        <div style="text-align: left; background: #f8fafc; border-radius: 10px; padding: 16px 18px; margin-bottom: 24px; font-size: 13px; color: #475569; line-height: 1.6;">
            <p style="margin: 0 0 8px 0;"><strong>Next steps:</strong></p>
            <ol style="margin: 0; padding-left: 20px;">
                <li>Open the email sent from <strong>TeamForge</strong>.</li>
                <li>Click the <strong>Verify Email Address</strong> button.</li>
                <li>Log in to complete your profile and find teammates.</li>
            </ol>
            <p style="margin: 10px 0 0 0; font-size: 12px; color: #94a3b8;">Verification links expire after 24 hours.</p>
        </div>

        <div style="border-top: 1px solid #e2e8f0; padding-top: 20px; text-align: center;">
            <p style="font-size: 13px; color: #64748b; margin: 0 0 12px 0;">Didn't receive the email? Check your spam folder or request a new link:</p>
            
            <form action="/resend-verification" method="POST" style="display: flex; flex-direction: column; gap: 10px; max-width: 380px; margin: 0 auto;">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <input type="email" name="email" required placeholder="e.g. name@<%= typeof allowedDomain !== 'undefined' ? allowedDomain : 'kkwagh.edu.in' %>"
                       aria-label="Email address for resending verification"
                       value="<%= typeof email !== 'undefined' ? email : '' %>"
                       style="box-sizing: border-box; width: 100%; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px; outline: none;">
                <button type="submit"
                        style="width: 100%; padding: 10px 16px; font-size: 13.5px; font-weight: 600; border-radius: 8px; background-color: #2563eb; color: #ffffff; border: none; cursor: pointer; transition: background 0.15s ease;">
                    Resend Verification Link
                </button>
            </form>
        </div>

        <div style="margin-top: 24px; font-size: 13.5px; color: #64748b;">
            <a href="/login" style="color: #2563eb; text-decoration: none; font-weight: 600;">Back to Log In</a>
        </div>

    </div>

</div>
