<% layout("/layouts/boilerplate") -%>

<div class="page-container" style="max-width: 960px; margin: 40px auto; padding: 0 16px;">

    <!-- Hero Header -->
    <div style="text-align: center; margin-bottom: 48px;">
        <div style="display: inline-flex; align-items: center; gap: 8px; background: #eff6ff; color: #1e40af; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; margin-bottom: 16px;">
            <span>Campus Teaming Workflow</span>
        </div>
        <h1 style="font-size: 34px; font-weight: 800; color: #0f172a; margin: 0 0 12px 0; letter-spacing: -0.5px;">
            How TeamForge Works
        </h1>
        <p style="font-size: 16px; color: #64748b; max-width: 640px; margin: 0 auto; line-height: 1.6;">
            A transparent, mathematical approach to finding balanced teammates, locking hackathon spots, and building verifiable campus credibility.
        </p>
    </div>

    <!-- 4 Steps Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-bottom: 48px;">

        <!-- Step 1 -->
        <div class="dashboard-card-new" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 28px 24px; position: relative;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; margin-bottom: 16px;">
                1
            </div>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">Sign Up & Build Profile</h2>
            <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 14px 0;">
                Authenticate with your official institutional email (<code>@kkwagh.edu.in</code>). Connect GitHub via secure OAuth and list your technical skill proficiencies from level 1 to 5.
            </p>
            <div style="font-size: 12px; color: #059669; font-weight: 600; display: flex; align-items: center; gap: 6px;">
                <span>✓ Verified academic identity & repos</span>
            </div>
        </div>

        <!-- Step 2 -->
        <div class="dashboard-card-new" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 28px 24px; position: relative;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #f0fdf4; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; margin-bottom: 16px;">
                2
            </div>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">Post Roles or Discover</h2>
            <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 14px 0;">
                Team leads define project roles with required and preferred competencies. Candidates explore opportunities with mathematical match score transparency (0–100%).
            </p>
            <div style="font-size: 12px; color: #059669; font-weight: 600; display: flex; align-items: center; gap: 6px;">
                <span>✓ Explainable formula breakdown</span>
            </div>
        </div>

        <!-- Step 3 -->
        <div class="dashboard-card-new" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 28px 24px; position: relative;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #fffbeb; color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; margin-bottom: 16px;">
                3
            </div>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">Mutual 24-Hour Match</h2>
            <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 14px 0;">
                Send invitations or submit applications. When an offer is accepted, a 24-hour mutual confirmation window activates to prevent ghosting and ensure commitment.
            </p>
            <div style="font-size: 12px; color: #059669; font-weight: 600; display: flex; align-items: center; gap: 6px;">
                <span>✓ Two-way mutual confirmation</span>
            </div>
        </div>

        <!-- Step 4 -->
        <div class="dashboard-card-new" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 28px 24px; position: relative;">
            <div style="width: 44px; height: 44px; border-radius: 12px; background: #faf5ff; color: #9333ea; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 800; margin-bottom: 16px;">
                4
            </div>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">Lock & Double-Blind Review</h2>
            <p style="font-size: 14px; color: #64748b; line-height: 1.6; margin: 0 0 14px 0;">
                Confirmed members are locked for the event, protecting teams from last-minute drops. After the event, exchange anonymous double-blind reviews to elevate campus leaderboard standings.
            </p>
            <div style="font-size: 12px; color: #059669; font-weight: 600; display: flex; align-items: center; gap: 6px;">
                <span>✓ Authentic reputation & reviews</span>
            </div>
        </div>

    </div>

    <!-- Call to Action Banner -->
    <div style="background: linear-gradient(135deg, #1e3a8a, #2563eb); border-radius: 16px; padding: 36px 32px; text-align: center; color: white; margin-bottom: 32px;">
        <h2 style="font-size: 24px; font-weight: 800; margin: 0 0 10px 0;">Ready to assemble your dream team?</h2>
        <p style="font-size: 15px; color: #bfdbfe; margin: 0 0 24px 0; max-width: 520px; margin-left: auto; margin-right: auto;">
            Join your peers at K.K. Wagh Institute of Engineering Education & Research and compete in upcoming hackathons.
        </p>
        <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <% if (currentUser) { %>
                <a href="/dashboard" class="landing-btn landing-btn-primary" style="background: white; color: #1e3a8a; font-weight: 700; padding: 12px 26px; border-radius: 8px; text-decoration: none;">
                    Go to Your Dashboard
                </a>
                <a href="/discover" class="landing-btn landing-btn-secondary" style="border: 1px solid rgba(255,255,255,0.4); color: white; font-weight: 600; padding: 12px 24px; border-radius: 8px; text-decoration: none;">
                    Browse Open Roles
                </a>
            <% } else { %>
                <a href="/signup" class="landing-btn landing-btn-primary" style="background: white; color: #1e3a8a; font-weight: 700; padding: 12px 26px; border-radius: 8px; text-decoration: none;">
                    Create Free Student Account
                </a>
                <a href="/login" class="landing-btn landing-btn-secondary" style="border: 1px solid rgba(255,255,255,0.4); color: white; font-weight: 600; padding: 12px 24px; border-radius: 8px; text-decoration: none;">
                    Sign In
                </a>
            <% } %>
        </div>
    </div>

</div>
