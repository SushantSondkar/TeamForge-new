<% layout("/layouts/boilerplate") -%>

<div class="page-container" style="max-width: 650px; margin: 40px auto; padding: 0 20px;">
    
    <div style="text-align: center; margin-bottom: 28px;">
        <div style="display: inline-flex; align-items: center; justify-content: center; width: 64px; height: 64px; border-radius: 50%; background: #e0e7ff; color: #4338ca; margin-bottom: 14px;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
        </div>
        <h1 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 0 0 8px 0; letter-spacing: -0.5px;">Share Your Pilot Feedback</h1>
        <p style="color: #64748b; font-size: 14.5px; line-height: 1.5; margin: 0;">Your ratings and comments help improve TeamForge for upcoming campus hackathons and student innovators.</p>
    </div>

    <% if (selectedCategory === 'team_locked') { %>
    <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 10px; padding: 14px 18px; margin-bottom: 22px; display: flex; align-items: center; gap: 12px;">
        <span style="font-size: 22px;">🎉</span>
        <div>
            <strong style="color: #065f46; font-size: 14px; display: block;">Congratulations on locking your hackathon team spot!</strong>
            <span style="color: #047857; font-size: 13px;">Tell us how seamless your matching and confirmation experience felt.</span>
        </div>
    </div>
    <% } %>

    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 28px 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
        <form action="/feedback" method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

            <!-- Star Rating (1-5) -->
            <div style="margin-bottom: 22px; text-align: center;">
                <label style="display: block; font-size: 14.5px; font-weight: 700; color: #1e293b; margin-bottom: 10px;">Overall Satisfaction Rating *</label>
                
                <div style="display: inline-flex; flex-direction: row-reverse; justify-content: center; gap: 8px;">
                    <input type="radio" id="star5" name="rating" value="5" required style="display: none;">
                    <label for="star5" class="star-label" style="font-size: 36px; color: #cbd5e1; cursor: pointer; transition: color 0.15s;" title="5 - Excellent">★</label>

                    <input type="radio" id="star4" name="rating" value="4" style="display: none;">
                    <label for="star4" class="star-label" style="font-size: 36px; color: #cbd5e1; cursor: pointer; transition: color 0.15s;" title="4 - Very Good">★</label>

                    <input type="radio" id="star3" name="rating" value="3" style="display: none;">
                    <label for="star3" class="star-label" style="font-size: 36px; color: #cbd5e1; cursor: pointer; transition: color 0.15s;" title="3 - Good">★</label>

                    <input type="radio" id="star2" name="rating" value="2" style="display: none;">
                    <label for="star2" class="star-label" style="font-size: 36px; color: #cbd5e1; cursor: pointer; transition: color 0.15s;" title="2 - Fair">★</label>

                    <input type="radio" id="star1" name="rating" value="1" style="display: none;">
                    <label for="star1" class="star-label" style="font-size: 36px; color: #cbd5e1; cursor: pointer; transition: color 0.15s;" title="1 - Poor">★</label>
                </div>
                <span id="ratingCaption" style="display: block; font-size: 13px; color: #64748b; margin-top: 6px;">Select 1 to 5 stars</span>
            </div>

            <style>
                .star-label:hover,
                .star-label:hover ~ .star-label,
                input[type="radio"]:checked ~ .star-label {
                    color: #f59e0b !important;
                }
            </style>

            <script>
                document.querySelectorAll('input[name="rating"]').forEach(radio => {
                    radio.addEventListener('change', (e) => {
                        const val = e.target.value;
                        const captions = {
                            "1": "1 Star · Needs Improvement",
                            "2": "2 Stars · Fair",
                            "3": "3 Stars · Good",
                            "4": "4 Stars · Very Good",
                            "5": "5 Stars · Excellent!"
                        };
                        const capEl = document.getElementById('ratingCaption');
                        if (capEl) capEl.textContent = captions[val] || '';
                    });
                });
            </script>

            <!-- Category -->
            <div style="margin-bottom: 20px;">
                <label for="feedbackCategory" style="display: block; font-size: 13.5px; font-weight: 600; color: #334155; margin-bottom: 6px;">Feedback Topic</label>
                <select id="feedbackCategory" name="category" style="width: 100%; height: 44px; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14.5px; background: #fff; box-sizing: border-box;">
                    <option value="general" <%= selectedCategory === 'general' ? 'selected' : '' %>>General Platform Experience</option>
                    <option value="team_locked" <%= selectedCategory === 'team_locked' ? 'selected' : '' %>>Team Matching & Locking Experience</option>
                    <option value="feature_request" <%= selectedCategory === 'feature_request' ? 'selected' : '' %>>Feature Suggestion / Idea</option>
                    <option value="bug" <%= selectedCategory === 'bug' ? 'selected' : '' %>>Report an Issue / Bug</option>
                </select>
            </div>

            <!-- Comment -->
            <div style="margin-bottom: 24px;">
                <label for="feedbackComment" style="display: block; font-size: 13.5px; font-weight: 600; color: #334155; margin-bottom: 6px;">Your Thoughts / Suggestions</label>
                <textarea id="feedbackComment" name="comment" rows="4" maxlength="1000" placeholder="What worked well? What could be improved for your hackathon team?" style="width: 100%; padding: 10px 12px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14.5px; font-family: inherit; box-sizing: border-box; line-height: 1.5;"></textarea>
                <span style="font-size: 12px; color: #94a3b8; display: block; margin-top: 4px;">Max 1,000 characters. Anonymous feedback (no email or password shared).</span>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <a href="/" class="btn-large-outline" style="text-decoration: none; padding: 11px 20px;">Cancel</a>
                <button type="submit" class="btn-large-primary" style="padding: 11px 28px; cursor: pointer; font-size: 15px;">Submit Feedback</button>
            </div>
        </form>
    </div>

</div>
