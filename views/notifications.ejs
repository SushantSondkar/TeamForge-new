<% layout("/layouts/boilerplate") -%>

<div class="notifications-page" style="padding: 20px 40px; max-width: 900px;">
    
    <h1 style="font-size: 24px; margin-bottom: 24px; color: #1e293b;">Notifications</h1>

    <div class="notif-tabs" style="display: flex; gap: 12px; margin-bottom: 24px;">
        <button style="background-color: #3b82f6; color: white; border: none; border-radius: 8px; padding: 8px 24px; font-weight: 500; cursor: pointer;">All</button>
        <button style="background-color: white; color: #64748b; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 24px; font-weight: 500; cursor: pointer;">Unread (3)</button>
    </div>

    <div class="notif-list" style="display: flex; flex-direction: column; gap: 16px;">
        
        <!-- Unread 1 -->
        <div class="notif-card" style="background: white; border: 1px solid #3b82f6; border-radius: 12px; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between;">
            <div style="display: flex; align-items: center; gap: 16px;">
                <div style="width: 40px; height: 40px; border-radius: 50%; background: #eff6ff; display: flex; align-items: center; justify-content: center; color: #3b82f6;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
                <div>
                    <strong style="display: block; font-size: 15px; color: #1e293b; margin-bottom: 4px;">Devon Lane accepted your invite</strong>
                    <span style="font-size: 13px; color: #64748b;">Backend Developer role for Synergy Core Alpha</span>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 16px;">
                <span style="font-size: 13px; color: #64748b;">2h ago</span>
                <div style="width: 8px; height: 8px; background-color: #3b82f6; border-radius: 50%;"></div>
            </div>
        </div>

