<% layout("/layouts/boilerplate") -%>

<div class="notifications-page" style="padding: 20px 40px; max-width: 900px;">
    
    <h1 style="font-size: 24px; margin-bottom: 24px; color: #1e293b;">Notifications</h1>

    <div class="notif-tabs" style="display: flex; gap: 12px; margin-bottom: 24px;">
        <button style="background-color: #3b82f6; color: white; border: none; border-radius: 8px; padding: 8px 24px; font-weight: 500; cursor: pointer;">All</button>
        <button style="background-color: white; color: #64748b; border: 1px solid #e2e8f0; border-radius: 8px; padding: 8px 24px; font-weight: 500; cursor: pointer;">Unread (3)</button>
    </div>

    <div class="notif-list" style="display: flex; flex-direction: column; gap: 16px;">
        <% if (notifications && notifications.length > 0) { %>
            <% notifications.forEach(n => { %>
                <div class="notif-card" style="background: white; border: 1px solid <%= n.type === 'success' ? '#10b981' : (n.type === 'danger' ? '#ef4444' : '#3b82f6') %>; border-radius: 12px; padding: 16px 24px; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div style="width: 40px; height: 40px; border-radius: 50%; background: <%= n.type === 'success' ? '#f0fdf4' : (n.type === 'danger' ? '#fef2f2' : '#eff6ff') %>; display: flex; align-items: center; justify-content: center; color: <%= n.type === 'success' ? '#10b981' : (n.type === 'danger' ? '#ef4444' : '#3b82f6') %>;">
                            <% if (n.type === 'success') { %>
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            <% } else { %>
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                            <% } %>
                        </div>
                        <div>
                            <strong style="display: block; font-size: 15px; color: #1e293b; margin-bottom: 4px;"><%= n.title %></strong>
                            <span style="font-size: 13px; color: #64748b;"><%= n.subtitle %></span>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <span style="font-size: 13px; color: #64748b;"><%= n.time %></span>
                        <div style="width: 8px; height: 8px; background-color: <%= n.type === 'success' ? '#10b981' : '#3b82f6' %>; border-radius: 50%;"></div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="text-align: center; padding: 40px; background: white; border-radius: 12px; border: 1px solid #e2e8f0; color: #64748b;">
                No notifications yet.
            </div>
        <% } %>
    </div>
</div>
