<% 
    locals.hideSidebar = (typeof currentUser === 'undefined' || !currentUser);
-%>
<% layout("/layouts/boilerplate") -%>

<div class="page-container" style="max-width: 840px; margin: 40px auto; padding: 0 20px;">
    
    <div style="margin-bottom: 32px; border-bottom: 1px solid #e2e8f0; padding-bottom: 24px;">
        <a href="/" style="color: #64748b; text-decoration: none; font-size: 13.5px; display: inline-flex; align-items: center; gap: 6px; margin-bottom: 12px; font-weight: 500;">
            ← Back to Home
        </a>
        <h1 style="font-size: 30px; font-weight: 800; color: #0f172a; margin: 0 0 8px 0; letter-spacing: -0.5px;">Terms of Service</h1>
        <p style="color: #64748b; font-size: 14px; margin: 0;">Last updated: October 28, 2026</p>
    </div>

    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 36px 32px; box-shadow: 0 2px 8px rgba(0,0,0,0.03); display: flex; flex-direction: column; gap: 28px; line-height: 1.6; color: #334155; font-size: 14.5px;">
        
        <section>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">1. Eligible Users</h2>
            <p style="margin: 0;">TeamForge is open exclusively to K.K. Wagh students with a valid, active college email address (ending in <code>@kkwagh.edu.in</code>).</p>
        </section>

        <section>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">2. Acceptable Use</h2>
            <p style="margin: 0 0 10px 0;">All users must adhere to community guidelines:</p>
            <ul style="margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px;">
                <li>Provide real information only; no fake profiles or impersonating others.</li>
                <li>No harassment, abusive conduct, or discrimination against peers.</li>
                <li>No spam, unsolicited advertising, or bulk messaging.</li>
                <li>Respect peer privacy: no sharing other people's contact details (such as their personal email or phone number) without their mutual consent.</li>
                <li>No scraping, automated indexing, or extracting data from TeamForge.</li>
            </ul>
        </section>

        <section>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">3. Hackathon Organizers</h2>
            <p style="margin: 0;">Hackathon organizers must be approved by the admin and must post only genuine events with verified faculty and timeline details.</p>
        </section>

        <section>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">4. Disclaimers</h2>
            <p style="margin: 0;">Matches and team results are not guaranteed; TeamForge is a student project provided as is without warranty of any kind.</p>
        </section>

        <section>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">5. Enforcement & Account Removal</h2>
            <p style="margin: 0;">We may remove accounts or content that break these rules or compromise platform safety. There is no automated self-service account deletion; users requesting account removal must contact support.</p>
        </section>

        <section>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">6. Changes to Terms</h2>
            <p style="margin: 0;">Terms may change; the date at the top shows the latest version. Your continued use of the platform represents agreement to the updated terms.</p>
        </section>

        <section>
            <h2 style="font-size: 18px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">7. Contact</h2>
            <p style="margin: 0;">For inquiries or assistance regarding these terms, contact us at <a href="mailto:<%= supportEmail %>" style="color: #2563eb; text-decoration: none; font-weight: 600;"><%= supportEmail %></a>.</p>
        </section>

    </div>

</div>
