<% layout("/layouts/boilerplate") -%>

<div class="event-detail-page page-container" style="max-width: 1100px;">
    
    <div style="margin-bottom: 20px;">
        <a href="/events" style="color: #64748b; text-decoration: none; font-size: 13.5px; display: inline-flex; align-items: center; gap: 6px; font-weight: 500; margin-bottom: 12px;">
            ← Back to All Events
        </a>
    </div>

    <!-- Event Hero / Header Card -->
    <div class="event-hero-card" style="background: white; border: 1px solid #e2e8f0; border-radius: 14px; padding: 32px; box-shadow: 0 2px 8px rgba(0,0,0,0.03); margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: start; gap: 20px; flex-wrap: wrap;">
            <div>
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 10px;">
                    <span style="background: #e0f2fe; color: #0369a1; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 16px;">
                        <%= event.mode || 'Offline' %>
                    </span>
                    <% if (isLocked) { %>
                        <span style="background: #fee2e2; color: #b91c1c; font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 16px;">
                            🔒 Locked for this Event
                        </span>
                    <% } else { %>
                        <span style="background: #dcfce7; color: #15803d; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 16px;">
                            ● Available to Join Teams
                        </span>
                    <% } %>
                </div>

                <h1 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 0 0 8px 0;"><%= event.name %></h1>
                <div style="color: #475569; font-size: 14px; font-weight: 500; margin-bottom: 14px;">
                    Organized by: <strong style="color: #1e293b;"><%= event.organizer %></strong>
                </div>

                <% if (event.description) { %>
                    <p style="color: #334155; font-size: 14px; line-height: 1.6; max-width: 700px; margin: 0 0 16px 0;">
                        <%= event.description %>
                    </p>
                <% } %>
            </div>

            <!-- "Create team requirement for this event" Entry Point -->
            <div style="display: flex; flex-direction: column; gap: 10px; min-width: 240px;">
                <% if (!isLocked) { %>
                    <a href="/team-requirement/new?eventId=<%= event._id %>" class="btn-large-primary"
                       style="text-decoration: none; padding: 12px 20px; font-size: 14px; font-weight: 600; border-radius: 8px; text-align: center; justify-content: center; background: #2563eb; color: white;">
                        + Create Team Requirement for this Event
                    </a>
                <% } else { %>
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; text-align: center;">
                        <span style="color: #b91c1c; font-weight: 600; font-size: 13px; display: block; margin-bottom: 4px;">🔒 Commitment Locked</span>
                        <span style="color: #64748b; font-size: 12px;">You are already committed to a team for <%= event.name %>.</span>
                    </div>
                <% } %>

                <% if (event.link) { %>
                    <a href="<%= event.link.startsWith('http') ? event.link : 'https://' + event.link %>" target="_blank" rel="noopener" class="btn-large-outline"
                       style="text-decoration: none; padding: 10px 18px; font-size: 13.5px; border-radius: 8px; text-align: center; justify-content: center;">
                        Official Event Portal ↗
                    </a>
                <% } %>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; background: #f8fafc; padding: 16px 20px; border-radius: 10px; margin-top: 20px; border: 1px solid #e2e8f0;">
            <div>
                <span style="color: #64748b; font-size: 12px; font-weight: 600; text-transform: uppercase;">Event Date</span>
                <div style="color: #0f172a; font-size: 15px; font-weight: 700; margin-top: 2px;"><%= formatDate(event.date, { weekday: 'short' }) %></div>
            </div>
            <div>
                <span style="color: #64748b; font-size: 12px; font-weight: 600; text-transform: uppercase;">Registration Deadline</span>
                <div style="color: #b45309; font-size: 15px; font-weight: 700; margin-top: 2px;"><%= formatDate(event.deadline, { weekday: 'short' }) %></div>
            </div>
            <div>
                <span style="color: #64748b; font-size: 12px; font-weight: 600; text-transform: uppercase;">Active Teams</span>
                <div style="color: #2563eb; font-size: 15px; font-weight: 700; margin-top: 2px;"><%= teams.length %> Teams Formed</div>
            </div>
        </div>
    </div>

    <!-- Organizer Promotion Settings (Admins & Approved Organizers Only) -->
    <% if (currentUser && (currentUser.isAdmin || (currentUser.isOrganizer && currentUser.organizerStatus === 'APPROVED'))) { %>
        <div style="background: white; border: 1px solid #bfdbfe; border-radius: 12px; padding: 20px 24px; margin-bottom: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.03);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="background: #2563eb; color: white; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 6px;">ORGANIZER SETTINGS</span>
                    <strong style="color: #1e3a8a; font-size: 14.5px;">Event Promotion Controls</strong>
                </div>
                <% if (event.isPromoted) { %>
                    <span style="background: #dcfce7; color: #15803d; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">PROMOTED ON DASHBOARD</span>
                <% } else { %>
                    <span style="background: #f1f5f9; color: #64748b; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 10px;">STANDARD VISIBILITY</span>
                <% } %>
            </div>

            <form action="/events/<%= event._id %>/promote" method="POST" style="margin: 0;">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div style="display: grid; grid-template-columns: auto 1fr 1fr auto; gap: 14px; align-items: center; flex-wrap: wrap;">
                    <label style="display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: #334155; cursor: pointer;">
                        <input type="checkbox" name="isPromoted" value="true" <%= event.isPromoted ? 'checked' : '' %>>
                        Promote Event
                    </label>
                    <input type="text" name="promotedTagline" value="<%= event.promotedTagline || '' %>" placeholder="Promotional Tagline (e.g. ₹50,000 Cash Prize + Mentorship)" style="padding: 8px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 13px;">
                    <input type="text" name="prizePool" value="<%= event.prizePool || '' %>" placeholder="Prize Pool (e.g. ₹50,000)" style="padding: 8px 12px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 13px;">
                    <button type="submit" class="btn-small-primary" style="padding: 8px 16px; font-size: 13px; border-radius: 6px; cursor: pointer;">Save Settings</button>
                </div>
            </form>
        </div>
    <% } %>

    <!-- Active Team Requirements for this Event -->
    <div style="margin-top: 32px;">
        <h2 style="font-size: 20px; font-weight: 700; color: #0f172a; margin: 0 0 16px 0;">Teams Looking for Members</h2>
        
        <% if (teams && teams.length > 0) { %>
            <div style="display: grid; gap: 16px;">
                <% teams.forEach(team => { %>
                    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 22px; box-shadow: 0 2px 6px rgba(0,0,0,0.02);">
                        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 8px;">
                            <div>
                                <h3 style="font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 4px 0;"><%= team.projectName %></h3>
                                <div style="font-size: 12.5px; color: #64748b;">
                                    Lead: <strong><%= team.createdBy ? team.createdBy.name : 'Team Lead' %></strong> (<%= team.createdBy ? team.createdBy.department || 'Student' : '' %>) · Team Size: <%= team.teamSize %>
                                </div>
                            </div>
                            <span style="background: #f1f5f9; color: #475569; font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: 12px;">
                                Theme: <%= team.theme %>
                            </span>
                        </div>

                        <p style="font-size: 13.5px; color: #334155; margin: 0 0 14px 0;"><%= team.projectRequirement %></p>

                        <!-- Open Roles in this Team -->
                        <% if (team.roles && team.roles.length > 0) { %>
                            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px; margin-bottom: 14px;">
                                <div style="font-size: 11.5px; font-weight: 700; color: #64748b; text-transform: uppercase; margin-bottom: 8px;">OPEN ROLES</div>
                                <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                    <% team.roles.forEach(role => { %>
                                        <div style="background: white; border: 1px solid #cbd5e1; border-radius: 6px; padding: 6px 12px; font-size: 12.5px; display: flex; align-items: center; gap: 8px;">
                                            <strong><%= role.title %></strong>
                                            <span style="color: #64748b;">(<%= role.openings %> open)</span>
                                            <% if (currentUser && !isLocked && (!team.createdBy || !team.createdBy._id.equals(currentUser._id))) { %>
                                                <form action="/applications/apply" method="POST" style="margin: 0; display: inline;">
                                                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                                    <input type="hidden" name="teamRequirementId" value="<%= team._id %>">
                                                    <input type="hidden" name="role" value="<%= role.title %>">
                                                    <button type="submit" class="btn-small-primary" style="padding: 2px 8px; font-size: 11px; border-radius: 4px;">Apply</button>
                                                </form>
                                            <% } %>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>

                        <div style="font-size: 12px; color: #64748b;">
                            Deliverables: <%= team.deliverables %>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div style="background: white; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 36px; text-align: center;">
                <p style="color: #64748b; font-size: 14.5px; margin: 0 0 12px 0;">No team requirements posted for this event yet.</p>
                <% if (!isLocked) { %>
                    <a href="/team-requirement/new?eventId=<%= event._id %>" class="btn-small-primary" style="text-decoration: none; padding: 9px 18px; font-size: 13.5px; border-radius: 6px;">
                        Be the first to create a team for <%= event.name %>
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>

</div>
