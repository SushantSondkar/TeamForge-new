<% layout("/layouts/boilerplate") -%>

<div class="leaderboard-page page-container">
    <style>
        .cache-status-cached { color: #15803d; }
        .cache-status-fresh { color: #2563eb; }
    </style>
    
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
        <div>
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <h1 style="font-size: 26px; font-weight: 800; color: #0f172a; margin: 0;">Campus Talent Leaderboard</h1>
                <span style="background: linear-gradient(135deg, #f59e0b, #d97706); color: white; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                    🏆 Daily Ranked
                </span>
            </div>
            <p style="color: #64748b; font-size: 14px; margin: 6px 0 0 0;">
                Calculated as <strong>70% Reputation</strong> (verified wins, peer ratings, shortlists) + <strong>30% Platform Activity</strong>.
            </p>
        </div>

        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
            <div style="font-size: 12.5px; color: #64748b; text-align: right;">
                <div>Cache Status: <span class="<%= isCached ? 'cache-status-cached' : 'cache-status-fresh' %>" style="font-weight: 600;"><%= isCached ? 'Cached (24h Daily)' : 'Freshly Computed' %></span></div>
                <% if (cachedAt) { %>
                    <div style="font-size: 11.5px; color: #64748b;">Updated: <%= formatDateTime(cachedAt) %></div>
                <% } %>
            </div>
            <a href="/leaderboard?refresh=true<%= filters.branch ? '&branch=' + encodeURIComponent(filters.branch) : '' %><%= filters.year ? '&year=' + encodeURIComponent(filters.year) : '' %><%= filters.skill ? '&skill=' + encodeURIComponent(filters.skill) : '' %>" 
               class="btn-small-outline" 
               style="text-decoration: none; padding: 8px 14px; font-size: 13px; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px; background: white; border: 1px solid #cbd5e1; color: #334155;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>
                Recompute
            </a>
        </div>
    </div>

    <!-- Filters Section -->
    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 14px; padding: 18px 24px; margin-bottom: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.03);">
        <form method="GET" action="/leaderboard" style="display: flex; flex-wrap: wrap; gap: 16px; align-items: flex-end;">
            <!-- Branch / Department Filter -->
            <div style="flex: 1; min-width: 180px;">
                <label for="branchFilter" style="display: block; font-size: 12.5px; font-weight: 600; color: #475569; margin-bottom: 6px;">Department / Branch</label>
                <select id="branchFilter" name="branch" style="width: 100%; padding: 9px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13.5px; background: #f8fafc; color: #1e293b;">
                    <option value="">All Departments</option>
                    <option value="Computer Engineering" <%= filters.branch === 'Computer Engineering' ? 'selected' : '' %>>Computer Engineering</option>
                    <option value="Information Technology" <%= filters.branch === 'Information Technology' ? 'selected' : '' %>>Information Technology</option>
                    <option value="AI & Data Science" <%= filters.branch === 'AI & Data Science' ? 'selected' : '' %>>AI & Data Science</option>
                    <option value="Electronics & Telecommunication" <%= filters.branch === 'Electronics & Telecommunication' ? 'selected' : '' %>>E&TC</option>
                    <option value="Mechanical Engineering" <%= filters.branch === 'Mechanical Engineering' ? 'selected' : '' %>>Mechanical</option>
                    <option value="Civil Engineering" <%= filters.branch === 'Civil Engineering' ? 'selected' : '' %>>Civil</option>
                    <option value="Electrical Engineering" <%= filters.branch === 'Electrical Engineering' ? 'selected' : '' %>>Electrical</option>
                    <option value="Robotics & Automation" <%= filters.branch === 'Robotics & Automation' ? 'selected' : '' %>>Robotics & Automation</option>
                    <option value="Chemical Engineering" <%= filters.branch === 'Chemical Engineering' ? 'selected' : '' %>>Chemical</option>
                </select>
            </div>

            <!-- Academic Year Filter -->
            <div style="flex: 1; min-width: 140px;">
                <label for="yearFilter" style="display: block; font-size: 12.5px; font-weight: 600; color: #475569; margin-bottom: 6px;">Academic Year</label>
                <select id="yearFilter" name="year" style="width: 100%; padding: 9px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13.5px; background: #f8fafc; color: #1e293b;">
                    <option value="">All Years</option>
                    <option value="FE" <%= filters.year === 'FE' ? 'selected' : '' %>>FE (First Year)</option>
                    <option value="SE" <%= filters.year === 'SE' ? 'selected' : '' %>>SE (Second Year)</option>
                    <option value="TE" <%= filters.year === 'TE' ? 'selected' : '' %>>TE (Third Year)</option>
                    <option value="BE" <%= filters.year === 'BE' ? 'selected' : '' %>>BE (Final Year)</option>
                </select>
            </div>

            <!-- Skill Filter -->
            <div style="flex: 1.5; min-width: 220px;">
                <label for="skillFilter" style="display: block; font-size: 12.5px; font-weight: 600; color: #475569; margin-bottom: 6px;">Filter by Skill</label>
                <input id="skillFilter" type="text" name="skill" value="<%= filters.skill %>" placeholder="e.g. React, Python, Node.js..." style="width: 100%; padding: 9px 12px; border-radius: 8px; border: 1px solid #cbd5e1; font-size: 13.5px; background: #f8fafc; color: #1e293b; box-sizing: border-box;">
            </div>

            <!-- Action Buttons -->
            <div style="display: flex; gap: 8px; width: 100%; justify-content: flex-end; flex-wrap: wrap;">
                <button type="submit" class="btn-small-primary" style="padding: 10px 20px; font-size: 13.5px; border-radius: 8px; cursor: pointer; border: none; background: #2563eb; color: white; font-weight: 600;">
                    Apply Filters
                </button>
                <% if (filters.branch || filters.year || filters.skill) { %>
                    <a href="/leaderboard" class="btn-small-outline" style="text-decoration: none; padding: 9px 14px; font-size: 13px; border-radius: 8px; border: 1px solid #cbd5e1; color: #64748b; background: white; display: inline-flex; align-items: center;">
                        Clear
                    </a>
                <% } %>
            </div>
        </form>
    </div>

    <!-- Leaderboard Table -->
    <div style="background: white; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
        <% if (entries && entries.length > 0) { %>
            <div class="table-responsive">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
                    <thead>
                        <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: #64748b; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">
                            <th style="padding: 14px 20px; width: 60px; text-align: center;">Rank</th>
                            <th style="padding: 14px 20px;">Candidate</th>
                            <th style="padding: 14px 20px;">Branch & Year</th>
                            <th style="padding: 14px 20px;">Top Skills</th>
                            <th style="padding: 14px 20px; text-align: center;">Score Breakdown</th>
                            <th style="padding: 14px 20px; text-align: right; width: 110px;">Total Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% entries.forEach(entry => { %>
                            <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.15s ease;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background='transparent'">
                                <!-- Rank with Badges -->
                                <td style="padding: 16px 20px; text-align: center; vertical-align: middle;">
                                    <% if (entry.rank === 1) { %>
                                        <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: #fef3c7; color: #b45309; font-weight: 800; font-size: 14px; border: 1px solid #fde68a; box-shadow: 0 2px 4px rgba(245, 158, 11, 0.2);">
                                            🥇 1
                                        </span>
                                    <% } else if (entry.rank === 2) { %>
                                        <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: #f1f5f9; color: #475569; font-weight: 800; font-size: 14px; border: 1px solid #cbd5e1;">
                                            🥈 2
                                        </span>
                                    <% } else if (entry.rank === 3) { %>
                                        <span style="display: inline-flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; background: #ffedd5; color: #c2410c; font-weight: 800; font-size: 14px; border: 1px solid #fed7aa;">
                                            🥉 3
                                        </span>
                                    <% } else { %>
                                        <span style="font-weight: 700; color: #64748b; font-size: 14px;">
                                            #<%= entry.rank %>
                                        </span>
                                    <% } %>
                                </td>

                                <!-- Candidate Details & Badges -->
                                <td style="padding: 16px 20px; vertical-align: middle;">
                                    <div style="font-weight: 700; color: #0f172a; font-size: 15px; margin-bottom: 4px;">
                                        <%= entry.user.name %>
                                    </div>
                                    <div style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center;">
                                        <% if (entry.user.isGithubVerified) { %>
                                            <span style="background: #f0fdf4; color: #166534; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 12px; border: 1px solid #bbf7d0; display: inline-flex; align-items: center; gap: 4px;">
                                                ✓ GitHub Verified
                                            </span>
                                        <% } %>
                                        <% if (entry.user.isLinkedinLinked) { %>
                                            <span style="background: #eff6ff; color: #1e40af; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 12px; border: 1px solid #bfdbfe;">
                                                LinkedIn Linked
                                            </span>
                                        <% } %>
                                        <% if (entry.rawWins > 0) { %>
                                            <span style="background: #fef3c7; color: #92400e; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 12px;">
                                                🏆 <%= entry.rawWins %> Win Pts
                                            </span>
                                        <% } %>
                                        <% if (entry.shortlists > 0) { %>
                                            <span style="background: #f3e8ff; color: #6b21a8; font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 12px;">
                                                ⭐ <%= entry.shortlists %> Shortlists
                                            </span>
                                        <% } %>
                                    </div>
                                </td>

                                <!-- Branch & Year -->
                                <td style="padding: 16px 20px; vertical-align: middle; color: #334155;">
                                    <div style="font-weight: 600;"><%= entry.user.department || 'General' %></div>
                                    <div style="font-size: 12px; color: #64748b;"><%= entry.user.year || 'Student' %> · <%= entry.completeness %>% Complete</div>
                                </td>

                                <!-- Skills -->
                                <td style="padding: 16px 20px; vertical-align: middle;">
                                    <div style="display: flex; flex-wrap: wrap; gap: 4px; max-width: 260px;">
                                        <% if (entry.user.skills && entry.user.skills.length > 0) { %>
                                            <% entry.user.skills.slice(0, 3).forEach(s => { %>
                                                <span style="background: #f1f5f9; color: #334155; font-size: 11.5px; font-weight: 500; padding: 2px 8px; border-radius: 6px;">
                                                    <%= s.name %><% if (s.level) { %> (<%= s.level %>/5)<% } %>
                                                </span>
                                            <% }) %>
                                            <% if (entry.user.skills.length > 3) { %>
                                                <span style="font-size: 11px; color: #94a3b8; padding: 2px;">+<%= entry.user.skills.length - 3 %></span>
                                            <% } %>
                                        <% } else { %>
                                            <span style="color: #94a3b8; font-size: 12px;">No skills added</span>
                                        <% } %>
                                    </div>
                                </td>

                                <!-- Score Breakdown Pill -->
                                <td style="padding: 16px 20px; vertical-align: middle; text-align: center;">
                                    <div style="display: inline-flex; gap: 8px; font-size: 11.5px; background: #f8fafc; padding: 6px 12px; border-radius: 8px; border: 1px solid #e2e8f0;">
                                        <div title="Reputation: 0.4*Wins + 0.4*Reviews + 0.2*Shortlists">
                                            <span style="color: #64748b;">Rep (70%):</span>
                                            <strong style="color: #0f172a;"><%= Math.round(entry.reputation * 100) %>%</strong>
                                        </div>
                                        <span style="color: #cbd5e1;">|</span>
                                        <div title="Platform Recency: 1.0 (<=7d), 0.6 (<=30d), 0.2 (>30d)">
                                            <span style="color: #64748b;">Act (30%):</span>
                                            <strong style="color: #0f172a;"><%= Math.round(entry.activity * 100) %>%</strong>
                                        </div>
                                    </div>
                                </td>

                                <!-- Total Score -->
                                <td style="padding: 16px 20px; vertical-align: middle; text-align: right;">
                                    <div style="font-size: 22px; font-weight: 800; color: #2563eb; line-height: 1;">
                                        <%= entry.score %>
                                    </div>
                                    <div style="font-size: 11px; color: #94a3b8; font-weight: 500;">/ 100 pts</div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: 48px 24px; color: #64748b;">
                <div style="font-size: 40px; margin-bottom: 12px;">🔍</div>
                <h3 style="font-size: 17px; font-weight: 700; color: #0f172a; margin: 0 0 6px 0;">No Candidates Found</h3>
                <p style="font-size: 14px; margin: 0 0 16px 0;">Try adjusting your branch, academic year, or skill filters.</p>
                <a href="/leaderboard" class="btn-small-primary" style="text-decoration: none; padding: 8px 16px; font-size: 13px; border-radius: 8px;">
                    Reset All Filters
                </a>
            </div>
        <% } %>
    </div>
</div>
