<% 
    locals.hideSidebar = true;
    locals.hideNavOptions = true;
-%>
<% layout("/layouts/boilerplate") -%>

<div class="auth-page" style="max-width: 440px; margin: 48px auto; padding: 0 16px;">
    
    <div class="dashboard-card-new" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 36px 30px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);">
        
        <div style="text-align: center; margin-bottom: 24px;">
            <div style="background: linear-gradient(135deg, #2563eb, #3b82f6); color: white; width: 48px; height: 48px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; font-size: 20px; margin-bottom: 14px; box-shadow: 0 4px 10px rgba(37, 99, 235, 0.2);">TF</div>
            <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0 0 6px 0;">Set New Password</h2>
            <p style="color: #64748b; font-size: 13.5px; margin: 0;">Create a secure password for your account</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div style="background-color: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 11px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <span>⚠️</span>
                <span><%= error %></span>
            </div>
        <% } %>

        <form action="/reset-password" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <input type="hidden" name="token" value="<%= token %>">
            
            <div>
                <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">New Password</label>
                <input type="password" name="newPassword" required placeholder="Minimum 8 characters (1 letter, 1 number)"
                       style="width: 100%; box-sizing: border-box; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none;">
                <span style="display: block; font-size: 11.5px; color: #64748b; margin-top: 4px;">Must be at least 8 characters long and contain at least one letter and one number</span>
            </div>

            <div>
                <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">Confirm New Password</label>
                <input type="password" name="confirmNewPassword" required placeholder="Re-enter new password"
                       style="width: 100%; box-sizing: border-box; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none;">
            </div>

            <button type="submit" class="btn-large-primary"
                    style="margin-top: 8px; width: 100%; justify-content: center; padding: 11px; font-size: 14.5px; font-weight: 600; border-radius: 8px; background-color: #2563eb; color: #ffffff; border: none; cursor: pointer;">
                Update Password
            </button>
        </form>

        <div style="text-align: center; margin-top: 24px; font-size: 13.5px; color: #64748b;">
            Back to <a href="/login" style="color: #2563eb; text-decoration: none; font-weight: 600;">Log In</a>
        </div>

    </div>

</div>
