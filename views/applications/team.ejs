<% layout("/layouts/boilerplate") -%>

<div class="team-applications-page page-container" style="max-width: 1000px;">

    <!-- Breadcrumb / Back Link -->
    <div style="margin-bottom: 20px;">
        <a href="/dashboard" style="color: #2563eb; text-decoration: none; font-size: 14px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
            ← Back to Dashboard
        </a>
    </div>

    <!-- Header Card -->
    <div class="dashboard-card-new full-width" style="margin-bottom: 30px;">
        <div class="card-header-new">
            <span class="label-text">TEAM APPLICATIONS</span>
            <span class="badge badge-urgent"><%= team.theme ? team.theme.toUpperCase() : 'ACTIVE' %></span>
        </div>
        <h2 class="team-title" style="margin-bottom: 8px;"><%= team.projectName %></h2>
        <p style="color: #64748b; font-size: 14px; margin-bottom: 16px;"><%= team.projectRequirement %></p>
        
        <div class="team-stats-row">
            <div class="stat-col">
                <span class="stat-label">Active Roles</span>
                <span class="stat-value"><%= team.roles.map(r => r.title + ' (' + r.openings + ' open)').join(', ') %></span>
            </div>
            <div class="stat-col">
                <span class="stat-label">Team Size</span>
                <span class="stat-value"><%= team.teamSize %> Members</span>
            </div>
            <div class="stat-col">
                <span class="stat-label">Total Applications</span>
                <span class="stat-value"><%= applications ? applications.length : 0 %> Received</span>
            </div>
        </div>
    </div>

    <!-- Applications List Section -->
    <div class="dashboard-card-new full-width">
        <h3 class="card-title-new" style="margin-bottom: 20px;">Received Applications</h3>

        <div class="list-container" style="display: flex; flex-direction: column; gap: 16px;">
            <% if (applications && applications.length > 0) { %>
                <% applications.forEach(app => { %>
                    <div class="list-item" style="padding: 16px 20px; border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff; display: flex; align-items: center; justify-content: space-between; gap: 20px;">
                        
                        <!-- Applicant Details -->
                        <div class="item-main" style="display: flex; align-items: center; gap: 16px; flex: 1;">
                            <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Avatar" class="item-avatar" style="width: 48px; height: 48px; border-radius: 50%;">
                            <div class="item-details">
                                <strong style="font-size: 16px; color: #1e293b;"><%= app.applicantId ? app.applicantId.name : 'Unknown Candidate' %></strong>
                                <div class="item-meta-row" style="margin-top: 4px; display: flex; align-items: center; gap: 10px;">
                                    <span class="tag tag-blue"><%= app.role %></span>
                                    <span class="text-gray" style="font-size: 13px;">Applied on <%= new Date(app.createdAt).toLocaleDateString() %></span>
                                </div>
                                <% if (app.applicantId && app.applicantId.skills) { %>
                                    <div style="margin-top: 6px; font-size: 12px; color: #64748b;">
                                        Skills: <%= app.applicantId.skills.map(s => s.name).slice(0, 4).join(', ') %>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Status Badge & Controls -->
                        <div style="display: flex; align-items: center; gap: 16px;">
                            
                            <!-- Current Status Badge -->
                            <div style="text-align: right;">
                                <% if (app.status === 'ACCEPTED') { %>
                                    <span class="badge badge-success" style="padding: 6px 14px; font-size: 12px;">ACCEPTED</span>
                                    <div style="font-size: 11px; color: #64748b; margin-top: 4px;">Awaiting candidate confirmation</div>
                                <% } else if (app.status === 'LOCKED') { %>
                                    <span class="badge" style="background: #059669; color: #fff; padding: 6px 14px; font-size: 12px;">🔒 LOCKED</span>
                                <% } else if (app.status === 'ROLE_FILLED') { %>
                                    <span class="badge" style="background: #64748b; color: #fff; padding: 6px 14px; font-size: 12px;">ROLE FILLED</span>
                                <% } else if (app.status === 'DECLINED' || app.status === 'REJECTED') { %>
                                    <span class="badge badge-danger" style="padding: 6px 14px; font-size: 12px;">DECLINED</span>
                                <% } else if (app.status === 'EXPIRED') { %>
                                    <span class="badge badge-danger" style="padding: 6px 14px; font-size: 12px;">EXPIRED</span>
                                <% } else { %>
                                    <span class="badge badge-warning" style="padding: 6px 14px; font-size: 12px;">PENDING</span>
                                <% } %>
                            </div>

                            <!-- Actions Form Controls -->
                            <div class="action-buttons-small" style="display: flex; gap: 8px; align-items: center;">
                                <% if (app.status === 'PENDING') { %>
                                    <form action="/applications/<%= app._id %>/accept" method="POST" style="margin: 0;">
                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <button type="submit" class="btn-small-primary" style="background-color: #10b981; border-color: #10b981;">Accept</button>
                                    </form>
                                    <form action="/applications/<%= app._id %>/reject" method="POST" style="margin: 0;">
                                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                        <button type="submit" class="btn-small-outline" style="color: #ef4444; border-color: #ef4444;">Decline</button>
                                    </form>
                                <% } else if (app.status === 'LOCKED') { %>
                                    <!-- Contact Sharing for Locked Applicants -->
                                    <% if (app.bothOptedIn) { %>
                                        <div style="font-size: 12px; color: #065f46; background: #ecfdf5; padding: 6px 12px; border-radius: 6px; border: 1px solid #bbf7d0; text-align: left;">
                                            <div><strong>Email:</strong> <%= app.applicantId ? app.applicantId.email : '' %></div>
                                            <% if (app.applicantId && app.applicantId.github) { %>
                                                <div><strong>GitHub:</strong> <a href="https://github.com/<%= app.applicantId.github %>" target="_blank" style="color: #0284c7;">github.com/<%= app.applicantId.github %></a></div>
                                            <% } %>
                                            <% if (app.applicantId && app.applicantId.linkedin) { %>
                                                <div><strong>LinkedIn:</strong> <a href="<%= app.applicantId.linkedin %>" target="_blank" style="color: #0284c7;">Profile</a></div>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <form action="/applications/<%= app._id %>/contact-consent" method="POST" style="margin: 0;">
                                            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                                            <% if (app.myContactOptIn) { %>
                                                <span style="font-size: 12px; color: #64748b;">Waiting for candidate consent</span>
                                            <% } else { %>
                                                <button type="submit" class="btn-small-outline" style="font-size: 12px; padding: 4px 10px;">Share My Contact Info</button>
                                            <% } %>
                                        </form>
                                    <% } %>
                                <% } %>
                            </div>

                        </div>

                    </div>
                <% }); %>
            <% } else { %>
                <div style="text-align: center; padding: 40px 20px; color: #64748b;">
                    <p style="font-size: 15px; margin-bottom: 8px;">No applications received yet.</p>
                    <span style="font-size: 13px;">When candidates discover and apply to your open roles, they will appear here.</span>
                </div>
            <% } %>
        </div>
    </div>

</div>
