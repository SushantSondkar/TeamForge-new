<% layout("/layouts/boilerplate") -%>

<div class="discover-page">
    
    <div class="discover-header">
        <h1 class="page-title-new">Explore Active Requirements</h1>
        <p class="page-subtitle">Find teams and roles that match your skills. Apply directly with automatic evidence attachments.</p>
    </div>

    <!-- Tabs -->
    <div class="discover-tabs">
        <button class="discover-tab active" data-target="smart-recs">Smart Recommendations</button>
        <button class="discover-tab" data-target="search-teams">Search Teams</button>
        <button class="discover-tab" data-target="browse-events">Browse by Event</button>
    </div>

    <div class="discover-content-area">
        
        <!-- Tab: Smart Recommendations -->
        <div id="smart-recs" class="tab-pane active" style="display: flex; gap: 30px;">
            <div class="teams-list" style="flex: 1;">
                <% if (recommendedOpportunities && recommendedOpportunities.length > 0) { %>
                    <% recommendedOpportunities.forEach(opp => { %>
                        <div class="team-card-advanced">
                            <div class="team-card-header">
                                <div class="team-card-title">
                                    <h3><%= opp.team.projectName %></h3>
                                    <span class="badge badge-hackathon"><%= opp.team.theme ? opp.team.theme.toUpperCase() : 'PROJECT' %></span>
                                </div>
                                <div class="team-card-match">
                                    <span class="brief-badge"><%= opp.role.openings %> Openings</span>
                                    <span class="match-score"><%= opp.score %>% Match</span>
                                </div>
                            </div>
                            <div class="team-card-role">Role: <%= opp.role.title %></div>
                            
                            <div class="team-card-meta">
                                <div class="meta-col">
                                    <span class="meta-label">Required Skills</span>
                                    <div class="meta-value" style="font-size: 13px; font-weight: 500;">
                                        <%= opp.role.requiredSkills.join(', ') %>
                                    </div>
                                </div>
                                <div class="meta-col">
                                    <span class="meta-label">Team Size</span>
                                    <div class="meta-value" style="font-size: 13px; font-weight: 500;">
                                        <%= opp.team.teamSize %> Members
                                    </div>
                                </div>
                                <div class="meta-col">
                                    <span class="meta-label">Event Deadline</span>
                                    <div class="meta-value" style="font-size: 13px; font-weight: 500;">
                                        <%= new Date(opp.team.deadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    </div>
                                </div>
                            </div>

                            <div class="team-card-actions">
                                <% if (opp.isApplied) { %>
                                    <button class="btn-small-outline" disabled style="background-color: #10b981; color: white; border-color: #10b981;">Applied</button>
                                <% } else { %>
                                    <form action="/applications/apply" method="POST" style="margin: 0; display: inline;">
                                        <input type="hidden" name="teamRequirementId" value="<%= opp.team._id %>">
                                        <input type="hidden" name="role" value="<%= opp.role.title %>">
                                        <button type="submit" class="btn-small-primary">Apply Now</button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div style="text-align: center; padding: 40px; background: white; border-radius: 12px; border: 1px solid #e2e8f0;">
                        <p style="color: #64748b; font-size: 16px;">No matching opportunities found based on your skills.</p>
                    </div>
                <% } %>
            </div>
            
            <!-- Application Sidebar -->
            <div class="application-sidebar" style="display: none; width: 320px;">
                <div class="invite-sidebar-card">
                    <div class="invite-header" style="margin-bottom: 15px;">
                        <img src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Ccircle cx='12' cy='12' r='12' fill='%23e2e8f0'/%3E%3Cpath d='M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' fill='%239ca3af'/%3E%3C/svg%3E" alt="Avatar" class="invite-avatar">
                        <span class="invite-title">Applying to <strong class="app-team-name">Nexus Web Lab</strong> — <span class="app-role-name">Frontend Lead</span></span>
                    </div>
                    
                    <div class="invite-reason" style="margin-bottom: 15px;">
                        <span class="sidebar-label">AUTO-ATTACHED EVIDENCE</span>
                        <div class="reason-box">GitHub: 12 repos, LeetCode: 340 solved</div>
                    </div>

                    <div class="invite-message">
                        <span class="sidebar-label">OPTIONAL SHORT NOTE</span>
                        <textarea placeholder="Add a short note to the team lead (optional)" rows="4" class="form-control-new"></textarea>
                    </div>

                    <button class="btn-large-primary btn-submit-app" style="margin-bottom: 10px;">Submit Application</button>
                    <button class="btn-large-outline btn-cancel-app" style="border:none; color: #4b5563;">Cancel</button>
                </div>
            </div>
        </div>

        <!-- Tab: Search Teams -->
        <div id="search-teams" class="tab-pane" style="display: none;">
            <div class="search-filters-bar">
                <div class="search-input-wrapper">
                    <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    <input type="text" class="search-input" placeholder="Search by team name, skill, or role">
                </div>
                
                <div class="filter-dropdowns">
                    <select class="filter-select"><option>Skill: Any skill</option></select>
                    <select class="filter-select"><option>Availability: Any</option></select>
                    <select class="filter-select"><option>Reputation: Any rating</option></select>
                </div>
            </div>

            <div class="teams-list">
                <% if (teamRequirements && teamRequirements.length > 0) { %>
                    <% teamRequirements.forEach(team => { %>
                        <div class="team-card-advanced">
                            <div class="team-card-header">
                                <div class="team-card-title">
                                    <h3><%= team.projectName %></h3>
                                    <span class="badge badge-hackathon" style="text-transform: uppercase;"><%= team.theme %></span>
                                </div>
                                <div class="team-card-match">
                                    <span class="brief-badge">Active Requirement</span>
                                    <span class="match-score"><%= team.roles ? team.roles.length : 1 %> Role<%= team.roles && team.roles.length > 1 ? 's' : '' %></span>
                                </div>
                            </div>
                            <div class="team-card-role">Role: <%= (team.roles && team.roles.length > 0) ? team.roles[0].title : 'Open Role' %></div>
                            
                            <div class="team-card-meta">
                                <div class="meta-col">
                                    <span class="meta-label">Team Capacity</span>
                                    <div class="meta-value"><%= team.teamSize %> Members</div>
                                </div>
                                <div class="meta-col">
                                    <span class="meta-label">Open Roles</span>
                                    <div class="meta-value"><%= team.roles ? team.roles.length : 1 %> Available</div>
                                </div>
                                <div class="meta-col">
                                    <span class="meta-label">Deadline</span>
                                    <div class="meta-value"><%= new Date(team.deadline).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                                </div>
                            </div>

                            <div class="team-card-actions">
                                <button class="btn-small-outline">View Details</button>
                                <button class="btn-small-primary btn-apply-trigger" data-team="<%= team.projectName %>" data-role="<%= (team.roles && team.roles.length > 0) ? team.roles[0].title : 'Team Member' %>">Apply Now</button>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="team-card-advanced" style="text-align: center; padding: 30px;">
                        <p style="color: #64748b; margin-bottom: 12px;">No team requirements currently posted.</p>
                        <a href="/team-requirement/new" class="btn-small-primary" style="display: inline-block; text-decoration: none;">+ Create First Requirement</a>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Tab: Browse by Event -->
        <div id="browse-events" class="tab-pane" style="display: none;">
            <div class="events-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                
                <div class="event-card-new">
                    <div class="event-card-header">
                        <h3>PCCOE Hackathon</h3>
                        <span class="badge tag-blue">HACKATHON</span>
                    </div>
                    <p class="event-date">Date: Oct 15, 2026</p>
                    <div class="event-roles-info">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>12 open roles across 5 teams</span>
                    </div>
                    <button class="btn-dashed-new" style="margin:0; padding:10px;">View Roles ></button>
                </div>

                <div class="event-card-new">
                    <div class="event-card-header">
                        <h3>Aithon Sangamner</h3>
                        <span class="badge tag-yellow">AI HACKATHON</span>
                    </div>
                    <p class="event-date">Date: Oct 28, 2026</p>
                    <div class="event-roles-info">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>8 open roles across 3 teams</span>
                    </div>
                    <button class="btn-dashed-new" style="margin:0; padding:10px;">View Roles ></button>
                </div>

                <div class="event-card-new">
                    <div class="event-card-header">
                        <h3>Open Source Contribution Day</h3>
                        <span class="badge tag-green">CONTRIBUTION</span>
                    </div>
                    <p class="event-date">Date: Nov 12, 2026</p>
                    <div class="event-roles-info">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>15 open roles across 7 teams</span>
                    </div>
                    <button class="btn-dashed-new" style="margin:0; padding:10px;">View Roles ></button>
                </div>

                <div class="event-card-new">
                    <div class="event-card-header">
                        <h3>National Robotics Challenge</h3>
                        <span class="badge tag-red">COMPETITION</span>
                    </div>
                    <p class="event-date">Date: Dec 05, 2026</p>
                    <div class="event-roles-info">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                        <span>6 open roles across 4 teams</span>
                    </div>
                    <button class="btn-dashed-new" style="margin:0; padding:10px;">View Roles ></button>
                </div>

            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.discover-tab');
        const panes = document.querySelectorAll('.tab-pane');

        // Tab Switching
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                panes.forEach(p => p.style.display = 'none');
                
                tab.classList.add('active');
                const target = document.getElementById(tab.dataset.target);
                if (target) {
                    if (tab.dataset.target === 'smart-recs') {
                        target.style.display = 'flex';
                    } else {
                        target.style.display = 'block';
                    }
                }
            });
        });

        // Application Sidebar functionality
        const applyBtns = document.querySelectorAll('.btn-apply-trigger');
        const appSidebar = document.querySelector('.application-sidebar');
        const cancelBtn = document.querySelector('.btn-cancel-app');
        const submitBtn = document.querySelector('.btn-submit-app');
        
        applyBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const team = btn.getAttribute('data-team');
                const role = btn.getAttribute('data-role');
                
                document.querySelector('.app-team-name').textContent = team;
                document.querySelector('.app-role-name').textContent = role;
                
                // Show sidebar
                if (appSidebar) appSidebar.style.display = 'block';

                // reset buttons visually
                if (submitBtn) {
                    submitBtn.textContent = 'Submit Application';
                    submitBtn.style.backgroundColor = '';
                    submitBtn.disabled = false;
                }
            });
        });

        if (cancelBtn) {
            cancelBtn.addEventListener('click', () => {
                if (appSidebar) appSidebar.style.display = 'none';
            });
        }

        if (submitBtn) {
            submitBtn.addEventListener('click', (e) => {
                e.preventDefault();
                submitBtn.textContent = 'Application Sent!';
                submitBtn.style.backgroundColor = '#10b981';
                submitBtn.disabled = true;
                setTimeout(() => {
                    if (appSidebar) appSidebar.style.display = 'none';
                }, 2000);
            });
        }
    });
</script>

