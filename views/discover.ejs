<script>
    document.addEventListener('DOMContentLoaded', () => {
        const tabs = document.querySelectorAll('.discover-tab');
        const panes = document.querySelectorAll('.tab-pane');

        // Tab Switching
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                tabs.forEach(t => t.classList.remove('active'));
                panes.forEach(p => p.style.display = 'none');
                
                tab.classList.add('active');
                const target = document.getElementById(tab.dataset.target);
                if (target) {
                    if (tab.dataset.target === 'smart-recs') {
                        target.style.display = 'flex';
                    } else {
                        target.style.display = 'block';
                    }
                }
            });
        });

        // Application Sidebar functionality
        const applyBtns = document.querySelectorAll('.btn-apply-trigger');
        const appSidebar = document.querySelector('.application-sidebar');
        const cancelBtn = document.querySelector('.btn-cancel-app');
        const submitBtn = document.querySelector('.btn-submit-app');
        
        applyBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const team = btn.getAttribute('data-team');
                const role = btn.getAttribute('data-role');
                
                document.querySelector('.app-team-name').textContent = team;
                document.querySelector('.app-role-name').textContent = role;
                
                // Show sidebar
                if (appSidebar) appSidebar.style.display = 'block';

                // reset buttons visually
                if (submitBtn) {
                    submitBtn.textContent = 'Submit Application';
                    submitBtn.style.backgroundColor = '';
                    submitBtn.disabled = false;
                }
            });
        });

        if (cancelBtn) {
            cancelBtn.addEventListener('click', () => {
                if (appSidebar) appSidebar.style.display = 'none';
            });
        }

        if (submitBtn) {
            submitBtn.addEventListener('click', (e) => {
                e.preventDefault();
                submitBtn.textContent = 'Application Sent!';
                submitBtn.style.backgroundColor = '#10b981';
                submitBtn.disabled = true;
                setTimeout(() => {
                    if (appSidebar) appSidebar.style.display = 'none';
                }, 2000);
            });
        }
    });
</script>

