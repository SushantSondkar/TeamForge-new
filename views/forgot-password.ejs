<% 
    locals.hideSidebar = true;
    locals.hideNavOptions = true;
-%>
<% layout("/layouts/boilerplate") -%>

<div class="auth-page" style="max-width: 440px; margin: 48px auto; padding: 0 16px;">
    
    <div class="dashboard-card-new" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 36px 30px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);">
        
        <div style="text-align: center; margin-bottom: 24px;">
            <a href="/" style="display: inline-block; margin-bottom: 14px;" aria-label="TeamForge Home">
                <img src="/images/logo-icon.svg" alt="TeamForge Logo" width="48" height="48" style="width: 48px; height: 48px; display: block; margin: 0 auto; border-radius: 10px;">
            </a>
            <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0 0 6px 0;">Reset Your Password</h2>
            <p style="color: #64748b; font-size: 13.5px; margin: 0;">Enter your @kkwagh.edu.in email to receive reset instructions</p>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
            <div style="background-color: #fef2f2; border: 1px solid #fecaca; color: #b91c1c; padding: 11px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 20px; display: flex; align-items: center; gap: 8px;">
                <span>⚠️</span>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div style="background-color: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; padding: 11px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 20px;">
                <div style="font-weight: 600; margin-bottom: 4px;">Request Processed</div>
                <div><%= success %></div>
            </div>
        <% } %>

        <form action="/forgot-password" method="POST" style="display: flex; flex-direction: column; gap: 16px;">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            
            <div>
                <label for="forgotEmail" style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">College Email</label>
                <input type="email" id="forgotEmail" name="email" required placeholder="name@kkwagh.edu.in"
                       style="width: 100%; box-sizing: border-box; padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none;">
            </div>

            <button type="submit" class="btn-large-primary"
                    style="margin-top: 8px; width: 100%; justify-content: center; padding: 11px; font-size: 14.5px; font-weight: 600; border-radius: 8px; background-color: #2563eb; color: #ffffff; border: none; cursor: pointer;">
                Send Reset Link
            </button>
        </form>

        <div style="text-align: center; margin-top: 24px; font-size: 13.5px; color: #64748b;">
            Remembered your password? <a href="/login" style="color: #2563eb; text-decoration: none; font-weight: 600;">Return to Log In</a>
        </div>

    </div>

</div>
