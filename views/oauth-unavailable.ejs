<% 
    locals.hideSidebar = false;
    locals.hideNavOptions = false;
-%>
<% layout("/layouts/boilerplate") -%>

<div class="auth-page" style="max-width: 500px; margin: 48px auto; padding: 0 16px;">
    <div class="dashboard-card-new" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; padding: 36px 30px; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04); text-align: center;">
        
        <div style="background: #f1f5f9; color: #475569; width: 60px; height: 60px; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 26px; margin-bottom: 18px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);">
            🔒
        </div>
        
        <h2 style="font-size: 22px; font-weight: 700; color: #0f172a; margin: 0 0 10px 0;">
            <%= typeof serviceName !== 'undefined' && serviceName ? serviceName + ' ' : '' %>Verification Unavailable
        </h2>
        
        <p style="color: #64748b; font-size: 14.5px; line-height: 1.5; margin: 0 0 26px 0;">
            This verification is not available right now.
        </p>

        <a href="/profile" class="btn-large-primary"
           style="display: inline-flex; width: 100%; box-sizing: border-box; justify-content: center; padding: 12px; font-size: 14.5px; font-weight: 600; border-radius: 8px; background-color: #2563eb; color: #ffffff; text-decoration: none;">
            Back to Profile
        </a>

    </div>
</div>
