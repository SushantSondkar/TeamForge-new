PORT=8080
MONGODB_URI=mongodb://127.0.0.1:27017/teamforge
SESSION_SECRET=teamforge-super-secret-session-key-32-chars!
COOKIE_SECRET=teamforge-super-secret-cookie-key-32-chars!
CSRF_SECRET=teamforge-super-secret-csrf-key-32-chars!
SEED=false

# Base URL for email action links (verification, password reset)
APP_BASE_URL=http://localhost:8080

# Allowed Institutional Domain for Student Registration (Prompt 9B)
# Defaults to kkwagh.edu.in if omitted. Strictly enforced on server-side.
ALLOWED_DOMAIN=kkwagh.edu.in

# Phase 6 OAuth Providers (Optional in dev; mock fallback active if omitted)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_oauth_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_oauth_client_secret

# Phase 9 Transactional Email (SMTP) Configuration
# In development (NODE_ENV !== "production"): if SMTP_* is blank, email contents
# are safely printed directly to the server terminal console for testing links.
# In production (NODE_ENV=production): SMTP settings are strictly required and
# server startup will fail if missing.
#
# Free SMTP provider options:
# 1. Gmail App Password:
#    - Enable 2FA on Google Account -> Generate 16-character App Password.
#    - SMTP_HOST=smtp.gmail.com
#    - SMTP_PORT=587
#    - SMTP_SECURE=false
#    - SMTP_USER=your_email@gmail.com
#    - SMTP_PASS=your_16_character_app_password
# 2. Brevo (formerly Sendinblue) Free Tier:
#    - 300 free emails per day with standard SMTP relay.
#    - SMTP_HOST=smtp-relay.brevo.com
#    - SMTP_PORT=587
#    - SMTP_SECURE=false
#    - SMTP_USER=your_brevo_account_login
#    - SMTP_PASS=your_brevo_smtp_key
# 3. Resend Free Tier:
#    - 100 free emails per day (3,000/month).
#    - SMTP_HOST=smtp.resend.com
#    - SMTP_PORT=465 (or 587)
#    - SMTP_SECURE=true
#    - SMTP_USER=resend
#    - SMTP_PASS=re_your_api_key
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TeamForge" <noreply@teamforge.kkwagh.edu.in>

# Support and Issue Reporting
SUPPORT_EMAIL=support@yourdomain.com
